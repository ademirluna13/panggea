---
// src/layouts/Layout.astro
import { sanityClient } from "sanity:client";
import Header from '../components/layout/Header'; 
import Footer from '../components/layout/Footer';
import GoogleAnalytics from '../components/layout/GoogleAnalitycs.astro';
import Community from "../components/home/Community";
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
    image?: string; // 🔥 Imagen para redes sociales
    canonicalURL?: string;
}

// 1. DATA PARA EL BUSCADOR (Corregido y sincronizado con tus rutas)
const searchData = await sanityClient.fetch(`*[ _type in ["post", "patchNote", "tierEntry", "radarEvent", "gear"] && defined(title) && defined(slug.current) ]{
  title,
  "category": select(
    _type == "post" => "NOTAS",
    _type == "patchNote" => "UPDATES",
    _type == "tierEntry" => "GUIAS",
    _type == "radarEvent" => "RADAR",
    _type == "gear" => "HARDWARE",
    "ARCHIVO"
  ),
  "href": "/" + select(
    _type == "post" => "blog",
    _type == "patchNote" => "updates", 
    _type == "tierEntry" => "tier",
    _type == "radarEvent" => "radar", // 🔥 Sincronizado con /radar
    _type == "gear" => "vault",
    "#"
  ) + "/" + slug.current
}`);

const { 
    title, 
    description = "PanGGea | Hardware de alto rendimiento, análisis tácticos y el lore más profundo del gaming.",
    image = "/og-default.png", // 🔥 Ten una imagen por defecto en tu carpeta public/
} = Astro.props;

// Configuramos la URL para el SEO
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://panggea.site');
const socialImage = new URL(image, Astro.url.origin);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        {/* 🔍 SEO Básico */}
        <title>{title} | Blog Digital</title>
        <meta name="title" content={`${title} | PanGGea`} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        {/* 📘 Open Graph / Facebook / Discord / WhatsApp */}
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={`${title} | PanGGea`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />

        {/* 🐦 Twitter / X */}
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonical} />
        <meta property="twitter:title" content={`${title} | PanGGea`} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImage} />

        <GoogleAnalytics />
        
        {/* Fuentes */}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
        
        {/* 🔥 Google AdSense (PUB ID Real Cargado) */}
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5617654431862522"
                crossorigin="anonymous"></script>
    </head>
    <body class="bg-[#0a0a0a] text-white selection:bg-[#FF4500] selection:text-white overflow-x-hidden">
        
        <Header client:load searchData={searchData} />
        
        <slot />

        <Community client:load />
        <Footer />

        {/* 🔥 Inicializador de Adsense para evitar errores de carga */}
        <script is:inline>
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </body>
</html>