---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import { sanityClient } from "sanity:client";
import { Clock, ArrowRight } from 'lucide-react'; 

// Pedimos TODOS los Deep Dives, ordenados por los más nuevos
const archivePosts = await sanityClient.fetch(`*[_type == "post" && isDeepDive == true] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  "heroImage": mainImage.asset->url,
  description,
  readTime,
  isLegendary,
  publishedAt,
  "category": coalesce(categories[0]->title, "ARCHIVO")
}`);
---

<Layout title="LORE ARCHIVE // BITXOLO" description="Archivo clasificado de análisis técnicos y profundidad digital.">
  <Header client:load />

  <main class="bg-black min-h-screen pt-40 pb-20 px-6">
    <div class="max-w-7xl mx-auto">
      
      {/* HEADER DEL ARCHIVO */}
      <div class="mb-20 border-l-4 border-pangea-tertiary pl-8">
        <span class="font-label text-pangea-tertiary text-xs font-black tracking-[0.5em] uppercase italic">BASE DE DATOS</span>
        <h1 class="font-headline text-white text-7xl md:text-9xl font-black uppercase italic tracking-tighter">LORE_<br/><span class="text-pangea-tertiary">ARCHIVE</span></h1>
      </div>

      {/* BENTO GRID INMERSIVO */}
      <div class="grid grid-cols-1 md:grid-cols-6 auto-rows-[300px] md:auto-rows-[350px] gap-6">
        {archivePosts.map((post: { slug: any; heroImage: any; category: unknown; isLegendary: any; title: unknown; description: unknown; readTime: any; }, i: number) => (
          <a 
            href={`/news/${post.slug}`}
            class={`group relative overflow-hidden rounded-3xl border border-white/10 transition-all duration-700 hover:border-pangea-tertiary/40 
              ${i === 0 ? "md:col-span-4 md:row-span-2" : // La más nueva/Legendaria es gigante
                i === 1 ? "md:col-span-2 md:row-span-2" : // La segunda es alta
                "md:col-span-2 md:row-span-1"           // Las demás son pequeñas
              }`}
          >
            {/* Imagen de fondo con hover */}
            <div class="absolute inset-0 z-0">
              <div 
                class="absolute inset-0 bg-cover bg-center transition-all duration-1000 group-hover:scale-110 opacity-40 group-hover:opacity-60"
                style={{ backgroundImage: `url(${post.heroImage})` }}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent" />
            </div>

            {/* Contenido */}
            <div class="absolute inset-0 p-8 flex flex-col justify-end z-10">
               <span class="font-label text-pangea-tertiary text-[10px] font-black tracking-widest mb-4 uppercase italic">
                 {post.category} {post.isLegendary && "// CURRENT_LEGEND"}
               </span>
               
               <h3 class={`font-headline text-white font-black uppercase italic leading-none mb-4 group-hover:text-pangea-tertiary transition-colors
                 ${i === 0 ? "text-4xl md:text-6xl" : "text-2xl md:text-3xl"}`}>
                 {post.title}
               </h3>
               
               {i < 2 && <p class="text-white/40 text-sm line-clamp-2 mb-6 max-w-md">{post.description}</p>}
               
               <div class="flex items-center justify-between border-t border-white/10 pt-6">
                 <div class="flex items-center gap-3 text-pangea-tertiary font-label text-[10px] font-black">
                   {/* Icono de React, no necesita clase aquí */}
                   <Clock size={14} /> {post.readTime || '20 MIN'}
                 </div>
                 {/* EL FIX MÁGICO: className en vez de class porque ArrowRight es de React */}
                 <ArrowRight size={20} className="text-white/20 group-hover:text-pangea-tertiary transition-all" />
               </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>