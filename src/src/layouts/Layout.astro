---
// src/layouts/Layout.astro
interface Props {
    title: string;
    description?: string; // 👈 Agregamos esto como opcional (?)
}

// Le damos un valor por defecto por si alguna página no tiene descripción
const { title, description = "Pangea Digital Premiere - El futuro del hardware y gaming" } = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} /> <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | Pangea</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    </head>
    <body class="bg-[#0a0a0a] text-white selection:bg-orange-500">
        <slot />
    </body>
</html>