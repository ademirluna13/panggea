---
import Layout from '../layouts/Layout.astro';

import SpaceHeroScene from '../components/home/SpaceHeroScene';
import Hero from '../components/home/Hero';
import TrendingNow from '../components/home/TrendingNow';
import CategoryNav from '../components/home/CategoryNav';
import DeepDives from '../components/home/DeepDives';
import { sanityClient } from "sanity:client";
import Community from '../components/home/Community';
import Radar from '../components/home/Radar';
import { TacticalArsenal } from '../components/home/TacticalArsenal';
import { StatusFeed } from '../components/home/StatusFeed';
import RankingSystem from '../components/home/RankingSystem';
import GearVault from '../components/home/GearVault';
import type { GearItem } from '../components/home/GearVault';

import FeaturedCarousel from '../components/home/FeaturedCarousel.tsx';
import GuideHub from '../components/home/GuideHub';

// 🔥 ACTUALIZADO: Le agregamos la estructura del autor para que TypeScript no chille
interface Post {
  title: string;
  slug: string;
  heroImage: string;
  category: string;
  description: string;
  author?: {
    name: string;
    image: string;
    bio?: any;
    socials?: any;
  };
}

const title = "PANGGEA DIGITAL BLOG";
const description = "Consultoría de software de alto rendimiento y portal de análisis técnico.";

// ─── FETCHES CON AUTORES MAPEADOS ───

// 🔥 MEJORA 1: Expandimos el autor en los Trending Posts (Foto y Nombre)
const trendingPostsFetch = sanityClient.fetch(`*[_type == "post" && !(isDeepDive == true)] | order(publishedAt desc) [0...7] { 
  title, 
  "slug": slug.current, 
  "heroImage": mainImage.asset->url, 
  publishedAt, 
  description, 
  platform, 
  "category": coalesce(categories[0]->title, "EDITORIAL"),
  "author": author->{ name, "image": image.asset->url }
}`);

// 🔥 MEJORA 2: En los Deep Dives jalamos TODO el arsenal del autor (Foto, Nombre, Redes y Bio)
const deepDivesFetch = sanityClient.fetch(`*[_type == "post" && isDeepDive == true] | order(publishedAt desc) [0...4] { 
  title, 
  "slug": slug.current, 
  "heroImage": mainImage.asset->url, 
  "manualBg": sectionBg.asset->url, 
  description, 
  publishedAt, 
  readTime, 
  isLegendary, 
  platform, 
  "category": coalesce(categories[0]->title, "LORE"),
  "author": author->{ name, "image": image.asset->url, bio, socials }
}`);

const categoriesFetch = sanityClient.fetch(`*[_type == "category"] | order(title asc) { title, "slug": slug.current }`);

const patchNotesFetch = sanityClient.fetch(`*[_type == "patchNote"] | order(publishedAt desc)[0...6] {
  _id, title, "slug": slug.current, 
  "gameName": game->name,
  version, patchType, description, publishedAt, lastUpdateAt, tickerHighlights, "heroImage": mainImage.asset->url
}`);

const tierArsenalFetch = sanityClient.fetch(`*[_type == "tierEntry"] | order(rankScore desc)[0...6] {
  _id, title, "slug": slug.current, rank, description,
  "heroImage": mainImage.asset->url,
  "gameName": game->name,
  publishedAt,
  "gameLogo": game->logo.asset->url
}`);

const radarFetch = sanityClient.fetch(`*[_type == "radarEvent"] | order(eventDate asc) {
  _id, title, "slug": slug.current, eventDate, category, platform, hypeLevel, 
  description, 
  "heroImage": mainImage.asset->url
}`);

const gearFetch = sanityClient.fetch(`*[_type == "gear"] | order(_createdAt desc) {
  _id, 
  name, 
  "brand": brand->name, 
  price, 
  specs, 
  shortDescription,
  "brandLogo": brand->logo.asset->url,
  isHero, 
  "buyLink": buyLink,
  "category": category->title,
  "slug": slug.current,
  "image": mainImage.asset->url
}`);

const gearCategoriesFetch = sanityClient.fetch(`*[_type == "gearCategory"] | order(title asc) { title }`);

// 🔥 MEJORA 3: En el Carrusel gigante jalamos foto y nombre para el "By: Autor"
const featuredPostsFetch = sanityClient.fetch(`*[_type == "post" && isFeatured == true] | order(publishedAt desc) { 
  title, 
  "slug": slug.current, 
  "heroImage": mainImage.asset->url, 
  "category": coalesce(categories[0]->title, "GENERAL"), 
  description,
  "author": author->{ name, "image": image.asset->url }
}`);

const [trendingPosts, deepDives, categories, rawPatches, rawTiers, rawRadar, rawGear, rawGearCats, rawFeatured] = await Promise.all([
  trendingPostsFetch, deepDivesFetch, categoriesFetch, patchNotesFetch, tierArsenalFetch, radarFetch, gearFetch, gearCategoriesFetch, featuredPostsFetch
]);

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return `${d.getDate().toString().padStart(2, '0')} ${d.toLocaleString('es-MX', { month: 'short' }).toUpperCase()} ${d.getFullYear()}`;
};

const featuredPosts = Array.from(
  new Map(rawFeatured.map((post: any) => [post.category, post])).values()
).slice(0, 5) as Post[]; 

const patches = rawPatches.map((p: any) => ({
  id: p._id, game: p.gameName || 'SYSTEM', version: p.version || 'V1.0', title: p.title, type: p.patchType || 'BAL', desc: p.description, currentDate: formatDate(p.publishedAt), lastUpdate: p.lastUpdateAt ? formatDate(p.lastUpdateAt) : '', img: p.heroImage || null, slug: p.slug
}));

const tickerItems = rawPatches.flatMap((patch: any) => {
  if (!patch.tickerHighlights) return [];
  return patch.tickerHighlights.map((change: string) => ({ game: patch.gameName, change, type: patch.patchType || 'BAL' }));
});

const tierEntries = rawTiers.map((t: any) => ({
  id: t._id, title: t.title, slug: t.slug, gameName: t.gameName || 'UNKNOWN', rank: t.rank || 'S', desc: t.description || 'Sin datos de escaneo disponibles.', img: t.heroImage || null, gameLogo: t.gameLogo || null, publishedAt: t.publishedAt
}));

const radarEvents = rawRadar.map((r: any) => {
  const d = new Date(r.eventDate);
  return {
    id: r._id, title: r.title, slug: r.slug, category: r.category || 'GAMING', platform: r.platform || 'GLOBAL', hypeLevel: r.hypeLevel || 80, description: r.description || '', img: r.heroImage || null, day: d.getDate().toString().padStart(2, '0'), month: d.toLocaleString('es-MX', { month: 'short' }).toUpperCase(),
  };
});

const gearItems: GearItem[] = rawGear.map((g: any) => ({
  id: g._id,
  name: g.name,
  slug: g.slug, 
  brand: g.brand || 'GENERIC',
  price: g.price,
  specs: g.specs || [],
  category: g.category || 'HARDWARE',
  shortDescription: g.shortDescription || "", 
  image: g.image,
  isHero: g.isHero,
  link: g.buyLink || '/vault' 
}));

const guides = await sanityClient.fetch(`*[_type == "guide"] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  "heroImage": mainImage.asset->url,
  publishedAt,
  "gameName": game->name,
  "guideType": type->title,
  "difficulty": level->title,
  description
}`);

const guideTypes = await sanityClient.fetch(`*[_type == "guideType"] | order(title asc) { title }`);
const typeList = guideTypes.map((t: { title: string }) => t.title);
const gearCategoriesList = ["TODO", ...rawGearCats.map((c: any) => (c.title as string).toUpperCase())] as string[];
---

<Layout title={title} description={description}>
  
  <main class="w-full min-h-screen transition-colors duration-500">
    
    <section class="relative h-[100svh] w-full bg-black overflow-hidden">
      <div class="absolute inset-0 z-0">
        <SpaceHeroScene client:only="react" />
      </div>
      <div class="absolute inset-0 z-30 flex flex-col pointer-events-none">
        <Hero client:load />
      </div>
    </section>

    {/* Contenedor macro adaptativo: Permite que los renglones se estiren por completo */}
    <div class="w-full flex flex-col gap-24 py-12">
      
      {/* Secciones individuales contenidas a 1200px */}
      <div class="max-w-[1200px] mx-auto w-full px-4 sm:px-6">
        <CategoryNav client:load categories={categories} />
      </div>

      {/* Componentes de Renglón Abierto (Full-Bleed para el color sólido de los temas) */}
      {featuredPosts.length > 0 && <FeaturedCarousel client:load posts={featuredPosts} />}

      <TrendingNow client:load posts={trendingPosts} />

      <StatusFeed client:load patches={patches} tickerItems={tickerItems} />

      <DeepDives client:load posts={deepDives} />

      {/* El bloque restante de tus herramientas tácticas centraditas a 1200px */}
      <div class="max-w-[1200px] mx-auto w-full px-4 sm:px-6 flex flex-col gap-24">
        
        <section id="guides" class="border-t border-white/5 pt-12">
          <GuideHub client:visible guides={guides} types={typeList} />
        </section>

        <section id="tier" class="border-t border-white/5 pt-12">
          <TacticalArsenal client:load entries={tierEntries} />
        </section>

        <section id="radar" class="border-t border-white/5 pt-12">
          <Radar client:load events={radarEvents} />
        </section>

        <section id="vault" class="border-t border-white/5 pt-12 pb-24">
          <GearVault client:load items={gearItems} categories={gearCategoriesList} />
        </section>

      </div>

    </div>

  </main>
</Layout>