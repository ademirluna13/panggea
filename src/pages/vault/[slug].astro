---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Zap, ShieldCheck, User, Gamepad2 } from 'lucide-react';
// 🔥 Importamos componentes tácticos
import SharedButton from '../../components/layout/SharedButton';


export async function getStaticPaths() {
  const items = await sanityClient.fetch<any[]>(`*[_type == "gear" && defined(slug.current)]{
    "slug": slug.current
  }`);

  return items.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const item = await sanityClient.fetch(`*[_type == "gear" && slug.current == $slug][0]{
  "id": _id,
  name,
  "slug": slug.current,
  "brand": brand->name,
  "brandLogo": brand->logo.asset->url,
  "authorName": author->name, 
  "gameName": relatedGame->name,
  price,
  specs,
  shortDescription,
  description,
  "category": category->title,
  "image": mainImage.asset->url,
  buyLink
}`, { slug });

if (!item) {
  return Astro.redirect('/vault');
}

// Lógica de reescalado (TAMAÑOS MÁS PEQUEÑOS)
const nameLength = item?.name?.length || 0;
let titleSizeClass = "text-5xl md:text-6xl lg:text-[80px]"; // Tamaño base

if (nameLength > 60) {
  titleSizeClass = "text-3xl md:text-4xl lg:text-[45px]"; 
} else if (nameLength > 35) {
  titleSizeClass = "text-4xl md:text-5xl lg:text-[60px]"; 
}

const specs = Array.isArray(item.specs) ? item.specs : [];
const currentUrl = Astro.url.href;
---

<Layout 
  title={`${item.name} | PanGGea`} 
  description={item.shortDescription || item.description}
  image={item.image} 
>
  <Header client:load />

  <main class="bg-[#020202] min-h-screen relative font-sans text-white overflow-hidden">
    
    {/* ─── ADN RGB BITXOLO ─── */}
    <style is:global>
      @keyframes rgb-move {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      .text-rgb {
        background: linear-gradient(90deg, #ff0000, #00ff00, #00ffff, #ff00ff, #ff0000);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rgb-move 4s linear infinite;
      }
    </style>

    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_0%,rgba(0,255,255,0.05)_0%,transparent_70%)]"></div>

    {/* 📸 HERO SECTION */}
    <div class="relative w-full h-[65vh] min-h-[500px] flex items-end pb-16 border-b border-white/5">
      <div class="absolute inset-0 z-0 bg-[#050505] flex items-center justify-center overflow-hidden">
        {item.image ? (
          <img src={item.image} alt={item.name} class="w-full h-full object-cover grayscale-0 opacity-80 lg:grayscale lg:opacity-25 lg:hover:grayscale-0 lg:hover:opacity-60 transition-all duration-1000" />
        ) : (
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(0,255,255,0.05)_0%,transparent_70%)]"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/80 to-transparent"></div>
      </div>

      <div class="max-w-[1200px] mx-auto px-6 w-full relative z-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="bg-white/10 text-rgb font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 border border-white/10">
            {item.category || 'GEAR'}
          </span>
          <span class="border border-white/10 bg-black/50 backdrop-blur-sm text-white/70 font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 flex items-center gap-2">
            {item.brandLogo ? (
              <img src={item.brandLogo} alt={item.brand || 'Marca'} class="h-3 w-auto invert opacity-70" />
            ) : (
              <Zap size={12} className="text-white/40" />
            )}
            {item.brand || 'PanGGea'}
          </span>
        </div>

        <h1 class={`font-headline ${titleSizeClass} font-black uppercase italic leading-[0.85] mb-8 tracking-tighter text-rgb drop-shadow-2xl break-words`}>
          {item.name}
        </h1>

        {/* 🚀 MAPEADO: PRECIO, AUTOR Y JUEGO RELACIONADO */}
        <div class="flex flex-wrap items-center gap-y-6 border-t border-white/10 pt-6">
          
          {/* Valor */}
          <div class="flex items-center gap-3 pr-8 border-r border-white/10">
            <div class="w-8 h-8 rounded-full border border-white/10 bg-white/5 flex items-center justify-center text-white/60 font-bold">$</div>
            <div>
              <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Valor Táctico</span>
              <span class="block font-headline italic text-xl text-white font-black leading-none">{item.price || 'N/A'}</span>
            </div>
          </div>

          {/* Tester (Autor) */}
          {item.authorName && (
            <div class="flex items-center gap-3 px-8 border-r border-white/10">
              <User size={18} className="text-[#00F0FF]" />
              <div>
                <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Field_Tester</span>
                <span class="block font-bold text-xs text-white uppercase leading-none">{item.authorName}</span>
              </div>
            </div>
          )}

          {/* Juego Relacionado */}
          {item.gameName && (
            <div class="flex items-center gap-3 pl-8">
              <Gamepad2 size={18} className="text-[#FF0055]" />
              <div>
                <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Special_Edition</span>
                <span class="block font-bold text-xs text-white uppercase leading-none">{item.gameName}</span>
              </div>
            </div>
          )}

        </div>
      </div>
    </div>

    {/* 📝 SECCIÓN DE CONTENIDO CON ESCOLTA DE ADS */}
    <div class="max-w-[1750px] mx-auto px-4 md:px-6 py-16 lg:py-24 relative z-10 flex justify-center items-start gap-8 xl:gap-12 w-full">
      
 
      <div class="flex-1 max-w-[1200px] w-full">
        <div class="mb-12">
          <a href="/vault" class="group flex items-center gap-4 text-white/30 hover:text-white transition-colors font-mono text-[10px] uppercase tracking-[0.3em] w-max">
            <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
            <span>Volver al Centro de Datos</span>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
          <div class="lg:col-span-8">
            <div class="prose prose-invert prose-p:text-white/70 prose-p:leading-relaxed prose-p:text-lg max-w-none break-words mb-20">
              <p class="whitespace-pre-wrap break-words">
                {item.description || item.shortDescription || "Unidad asegurada. Los registros detallados de esta pieza de hardware aún están siendo procesados."}
              </p>
            </div>
          </div>

          <aside class="lg:col-span-4 flex flex-col gap-8">
            <div class="bg-[#050505] border border-white/5 hover:border-white/20 p-8 shadow-2xl relative transition-colors duration-500 lg:sticky lg:top-32 group overflow-hidden">
              <div class="flex items-center gap-3 mb-8">
                <div class="h-[2px] w-6 bg-gradient-to-r from-red-500 via-green-500 to-blue-500"></div>
                <span class="font-mono text-[10px] text-white/60 font-bold uppercase tracking-widest">Specs Técnicos</span>
              </div>

              <div class="space-y-4 mb-10">
                {specs.length > 0 ? specs.map((spec: string, i: number) => (
                  <div class="border-b border-white/5 pb-3 last:border-0">
                    <span class="block text-white/30 font-mono text-[8px] uppercase tracking-widest mb-1">
                      DATO TÁCTICO 0{i + 1}
                    </span>
                    <span class="block text-white font-bold text-sm tracking-wide break-words uppercase">
                      {spec}
                    </span>
                  </div>
                )) : (
                  <div class="text-white/10 font-mono text-[9px] italic">Buscando parámetros...</div>
                )}
              </div>

              <div class="pt-8 border-t border-white/10 mb-6">
                 <SharedButton client:load title={item.name} text={item.shortDescription} url={currentUrl} />
              </div>

              <a href={item.buyLink || '#'} target="_blank" rel="noopener noreferrer" 
                 class="w-full flex items-center justify-between border border-white/10 bg-white/5 px-6 py-4 hover:border-white/40 hover:bg-white/10 transition-all duration-300 group/btn">
                <span class="font-mono text-[9px] uppercase tracking-widest font-bold text-white transition-colors">
                  {item.buyLink ? 'Adquirir Unidad' : 'Unidad en Análisis'}
                </span>
                <ShieldCheck size={16} className="text-white/40 group-hover/btn:text-[#00FF66] transition-colors" />
              </a>
            </div>
          </aside>
        </div>

     
      </div>

 

    </div>
  </main>
</Layout>