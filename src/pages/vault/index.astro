---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Zap, ArrowRight } from 'lucide-react';
// 🔥 Importamos el componente de anuncios

import Community from '../../src/components/home/Community';

const vaultItems = await sanityClient.fetch<any[]>(`*[_type == "gear" && defined(slug.current)] | order(_createdAt desc) {
  "id": _id,
  name,
  "slug": slug.current,
  "brand": brand->name,
  "brandLogo": brand->logo.asset->url,
  price,
  specs,
  shortDescription,
  "category": category->title,
  "image": mainImage.asset->url
}`);

// 🧠 HELPER FLUIDO PARA TÍTULOS
const getFontSize = (title: string, isBig: boolean = false) => {
  const length = title?.length || 0;
  if (isBig) {
    if (length > 40) return 'text-3xl md:text-5xl';
    return 'text-4xl md:text-6xl';
  }
  if (length > 30) return 'text-xl md:text-2xl';
  return 'text-2xl md:text-3xl';
};
---

<Layout title="THE VAULT | PanGGea" description="Hardware de alto rendimiento.">
  <Header client:load />

  <main class="bg-pangea-neutral min-h-screen pt-44 pb-32 relative overflow-hidden flex flex-col items-center w-full transition-colors duration-500 font-sans">
    
    <style is:global>
      @keyframes rgb-move {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      .text-rgb {
        background: linear-gradient(90deg, #ff0000, #00ff00, #00ffff, #ff00ff, #ff0000);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rgb-move 4s linear infinite;
      }
      .group:hover .group-hover-text-rgb {
        background: linear-gradient(90deg, #ff0000, #00ff00, #00ffff, #ff00ff, #ff0000);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rgb-move 4s linear infinite;
      }
      .spec-tag-rgb {
        background: linear-gradient(135deg, #0f2a2a 0%, #2a0f2a 50%, #0f1a2a 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: inset 0 0 10px rgba(0, 255, 255, 0.1);
        color: white;
      }
      .bg-rgb-soft {
        background: linear-gradient(90deg, rgba(255,0,0,0.03), rgba(0,255,0,0.03), rgba(0,255,255,0.03));
        background-size: 200% 200%;
        animation: rgb-move 6s ease infinite;
      }
      /* 🔥 NUEVA BARRA RGB INFERIOR 🔥 */
      .bg-rgb-bar {
        background: linear-gradient(90deg, #ff0000, #00ff00, #00ffff, #ff00ff, #ff0000);
        background-size: 200% auto;
        animation: rgb-move 4s linear infinite;
      }
    </style>

    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_0%,rgba(0,255,255,0.05)_0%,transparent_70%)]"></div>

    <div class="flex w-full max-w-[1600px] justify-center items-start px-4 md:px-6 relative z-10">
      
      <div class="max-w-[1200px] w-full">
        <button onclick="window.history.back();" class="group flex items-center gap-4 mb-14 text-white/30 hover:text-white transition-colors font-mono text-[10px] tracking-[0.4em] uppercase cursor-pointer w-max focus:outline-none">
          <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-white/40 group-hover:shadow-[0_0_15px_rgba(255,255,255,0.2)]">
            <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
          </div>
          <span class="transition-colors duration-300">SALIR DE LA BÓVEDA</span>
        </button>
        
        <header class="mb-14 border-b border-white/10 pb-10 flex flex-col md:flex-row justify-between items-end gap-8">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-[2px] w-10 bg-gradient-to-r from-red-500 via-green-500 to-blue-500"></div>
              <span class="font-mono text-white/40 text-[10px] tracking-[0.5em] uppercase italic">Pangea_Elite // V.2.6</span>
            </div>
            <h1 class="font-headline text-white text-6xl md:text-8xl lg:text-[100px] font-[950] tracking-tighter leading-[0.8] uppercase italic drop-shadow-2xl">
              THE <span class="text-rgb">VAULT</span>
            </h1>
          </div>
          <p class="text-white/40 text-xs italic max-w-xs text-left lg:text-right leading-relaxed">
            "Hardware de alto rendimiento. Sin prisa, sin clickbait. Solo máquinas puras."
          </p>
        </header>

        {/* ─── GRID DE CARDS ESTILO PANGEA (BENTO) ─── */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[410px]">
          {vaultItems.map((item: any, i: number) => {
            const isBig = i === 0;
            const specs = Array.isArray(item.specs) ? item.specs : [];

            return (
              <a 
                href={`/vault/${item.slug}`} 
                class={`group relative bg-pangea-card/40 backdrop-blur-xl border border-white/5 rounded-[1.8rem] overflow-hidden transition-all duration-500 shadow-2xl flex flex-col lg:hover:-translate-y-2 ${isBig ? "md:col-span-2 md:row-span-2" : "md:col-span-1 md:row-span-1"}`}
                onmouseenter="this.style.borderColor='rgba(0,255,255,0.4)'; this.style.boxShadow='0 0 25px rgba(0,255,255,0.2), inset 0 0 10px rgba(0,255,255,0.1)';"
                onmouseleave="this.style.borderColor='rgba(255,255,255,0.05)'; this.style.boxShadow='none';"
              >
                
                <div class="absolute inset-0 bg-rgb-soft opacity-0 lg:group-hover:opacity-100 transition-opacity pointer-events-none z-0"></div>

                {/* IMAGEN DE FONDO */}
                <div class="absolute inset-0 z-0 pointer-events-none bg-zinc-900/10">
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    class="absolute inset-0 w-full h-full object-contain p-8 md:p-12 grayscale-0 opacity-100 lg:grayscale lg:opacity-50 lg:group-hover:grayscale-0 lg:group-hover:opacity-100 transition-all duration-700" 
                  />
                  <div class="absolute h-[65%] bottom-0 inset-x-0 bg-gradient-to-t from-[#020202] via-[#020202]/95 to-transparent z-10 transition-all duration-500"></div>
                </div>

                {/* 🔥 TOP BAR (Tags, Specs movidos ARRIBA y Logo) 🔥 */}
                <div class="relative z-20 p-6 md:p-8 flex flex-col gap-4 w-full">
                  <div class="flex justify-between items-start w-full">
                    <span class="font-mono text-[8px] font-black px-2 py-1 rounded-sm border border-white/10 bg-black/60 uppercase tracking-widest backdrop-blur-md w-fit text-rgb">
                      {item.category || 'GEAR'}
                    </span>
                    
                    <div class="text-right flex items-center gap-2">
                       {item.brandLogo ? (
                          <img src={item.brandLogo} alt={item.brand} class="h-4 w-auto object-contain brightness-0 invert opacity-60 lg:group-hover:opacity-100 transition-all" />
                       ) : (
                          <Zap size={14} className="text-white/20 group-hover-text-rgb transition-colors" />
                       )}
                       <span class="text-white/40 font-mono text-[8px] font-black uppercase tracking-widest">{item.brand || 'PANGEA'}</span>
                    </div>
                  </div>

                  {/* 🔥 PROPS / SPECS AHORA SIEMPRE VISIBLES ARRIBA 🔥 */}
                  {specs.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {specs.slice(0, 3).map((s: string) => (
                        <span class="spec-tag-rgb font-mono text-[7px] px-2 py-1 uppercase tracking-widest font-bold rounded-sm">
                          {s}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                {/* BOTTOM BAR (Título, Desc y Precio) */}
                <div class="relative z-20 p-6 md:p-8 flex flex-col w-full mt-auto">
                  <h3 
                    class={`font-headline text-white font-black uppercase italic tracking-tighter leading-none group-hover-text-rgb transition-all duration-300 break-words hyphens-auto ${getFontSize(item.name, isBig)}`}
                    style="text-shadow: 0 2px 10px rgba(0,0,0,0.5)"
                  >
                    {item.name}
                  </h3>
                  
                  {/* ANIMACIÓN RESPONSIVA (Solo para la descripción) */}
                  <div class="grid transition-all duration-500 ease-in-out grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr] w-full">
                    <div class="overflow-hidden opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-all duration-500">
                      <p class="text-white/50 text-[11px] italic leading-tight line-clamp-2 pt-3 break-words">
                        {item.shortDescription || "Unidad táctica en despliegue. Analizando parámetros."}
                      </p>
                    </div>
                  </div>

                  {/* FOOTER DEL BENTO (Precio y Flecha) */}
                  <div class="flex items-center justify-between border-t border-white/5 pt-4 mt-4">
                    <span class={`font-headline font-black italic text-white group-hover-text-rgb transition-all duration-300 ${isBig ? 'text-4xl' : 'text-3xl'}`}>
                      {item.price}
                    </span>
                    
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[8px] font-bold tracking-[0.2em] uppercase text-white/40 group-hover-text-rgb transition-colors hidden md:block">
                         {isBig ? "VER EXPEDIENTE" : "ANALIZAR"}
                      </span>
                      <ArrowRight size={18} className="text-white/40 group-hover:text-white lg:group-hover:translate-x-2 transition-all duration-500" />
                    </div>
                  </div>

                </div>

                {/* 🔥 BARRA INFERIOR NEÓN RGB ESTANDARIZADA 🔥 */}
                <div class="absolute bottom-0 left-0 h-1.5 transition-all duration-1000 w-0 lg:group-hover:w-full z-30 bg-rgb-bar shadow-[0_0_15px_rgba(0,255,255,0.2)]"></div>
              </a>
            );
          })}
        </div>

      </div>
    </div>
  </main>

</Layout>