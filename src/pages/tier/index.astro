---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Target, Clock, ArrowRight } from 'lucide-react';

const tierEntries = await sanityClient.fetch(`*[_type == "tierEntry"] | order(rankScore desc) {
  title,
  "slug": slug.current,
  description,
  rank,
  rankScore,
  "gameName": game->name,
  "gameLogo": game->logo.asset->url,
  "heroImage": mainImage.asset->url,
  publishedAt, 
  longDescription
}`);

const uniqueGamesMap = new Map();
tierEntries.forEach((entry: any) => {
  const gName = entry.gameName?.toUpperCase() || 'UNKNOWN';
  if (!uniqueGamesMap.has(gName)) {
    uniqueGamesMap.set(gName, entry.gameLogo || null);
  }
});
const filters = [
  { name: 'ALL', logo: null },
  ...Array.from(uniqueGamesMap.entries()).map(([name, logo]) => ({ name, logo }))
];

const ACCENT_COLOR = "#00FF66"; 
const pageTitle = "TIER ARSENAL | PanGGea DATABASE";
const pageDescription = "Clasificación de élite y análisis del meta actual en el despliegue de combate.";

// 🧠 FUNCIÓN HELPER PARA REESCALAR EL TITULO POR SU LONGITUD
const getFontSize = (title: string, isBig: boolean) => {
  const length = title?.length || 0;
  if (isBig) {
    if (length > 50) return 'text-3xl sm:text-4xl md:text-5xl';
    if (length > 30) return 'text-4xl sm:text-5xl md:text-6xl';
    return 'text-5xl md:text-7xl';
  } else {
    if (length > 45) return 'text-lg md:text-xl';
    if (length > 25) return 'text-xl md:text-2xl';
    return 'text-xl md:text-3xl';
  }
};
---

<Layout title={pageTitle} description={pageDescription}>
  
  {/* 🔥 FIX 1: Cambiado a flex-col items-center y bg-pangea-neutral */}
  <main class="min-h-screen pt-44 pb-32 relative overflow-hidden font-sans flex flex-col items-center w-full transition-colors duration-500">
    
    {/* Glow Verde Táctico absoluto */}
    <div class="absolute inset-0 pointer-events-none" 
         style={{ background: `radial-gradient(circle at 50% 0%, ${ACCENT_COLOR}10 0%, transparent 70%)` }}>
    </div>

    {/* 🔥 FIX 2: Estructura Estándar de Contenedores (1600px exterior, 1200px interior) */}
    <div class="flex w-full max-w-[1600px] justify-center items-start gap-12 px-4 md:px-6 relative z-10">
      
      <div class="max-w-[1200px] w-full">

        {/* BOTÓN DE REGRESO */}
        <button 
          onclick="window.history.back()" 
          class="group flex items-center gap-4 mb-14 transition-all duration-500 font-mono text-[10px] tracking-[0.4em] uppercase w-max focus:outline-none"
        >
          <div class="p-2.5 border border-white/10 bg-white/[0.02] transition-all group-hover:border-[#00FF66]/60 group-hover:shadow-[0_0_15px_rgba(0,255,102,0.3)]">
            <ArrowLeft size={16} className="text-white/20 group-hover:text-[#00FF66]" />
          </div>
          <span class="text-white/20 transition-all group-hover:text-[#00FF66]">Back to Command // Volver</span>
        </button>
        
        {/* HEADER */}
        <header class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-[2px] w-8" style={{ backgroundColor: ACCENT_COLOR }}></div>
            <span class="font-mono text-[10px] tracking-[0.5em] text-white/40 uppercase italic">Meta_Stream // Tier_Access_Granted</span>
          </div>

          <h1 class="font-headline text-white text-6xl md:text-8xl lg:text-[115px] font-[950] tracking-tighter leading-[0.8] uppercase italic drop-shadow-2xl whitespace-nowrap overflow-hidden transition-all duration-500">
            TIER 
            <span class="text-transparent block sm:inline" style={{ WebkitTextStroke: `2px ${ACCENT_COLOR}` }}> ARSENAL</span>
          </h1>

          <div class="mt-12 w-full overflow-hidden border-y border-white/5 py-3 bg-white/[0.01] relative">
            <div class="flex whitespace-nowrap gap-20 animate-marquee">
              {[1,2,3].map(() => (
                <div class="flex gap-20 items-center">
                  {tierEntries.slice(0, 4).map((e: any) => (
                     <span class="font-mono text-[10px] text-[#00FF66] uppercase tracking-[0.3em]">ANALYSIS: {e.title} [{e.rank}]</span>
                  ))}
                  <span class="font-mono text-[10px] text-white/40 uppercase tracking-[0.3em]">DATABASE_2026</span>
                </div>
              ))}
            </div>
          </div>
        </header>

        {/* FILTROS */}
        <div class="flex items-center gap-6 sm:gap-10 mb-16 overflow-x-auto no-scrollbar py-4" id="filters-container">
          {filters.map((filter) => {
            const isAll = filter.name === 'ALL';
            return (
              <button data-filter={filter.name} class={`filter-btn group flex flex-col items-center gap-4 min-w-[80px] sm:min-w-[90px] transition-all focus:outline-none ${isAll ? 'active' : ''}`}>
                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-2 flex items-center justify-center transition-all duration-500 relative overflow-hidden border-white/10 bg-pangea-card group-[.active]:border-[#00FF66] group-[.active]:shadow-[0_0_20px_rgba(0,255,102,0.4)] hover:border-white/30 hover:scale-105">
                  {filter.logo ? (
                    <img src={filter.logo} alt={filter.name} class="w-full h-full object-cover transition-all duration-500 opacity-30 grayscale group-[.active]:opacity-100 group-[.active]:grayscale-0 group-hover:grayscale-0 group-hover:opacity-100" />
                  ) : (
                    <Target size={20} className="text-white/20 group-[.active]:text-[#00FF66]" />
                  )}
                </div>
                <span class="font-mono text-[8px] sm:text-[9px] font-bold tracking-widest uppercase text-white/20 group-[.active]:text-[#00FF66] group-hover:text-white transition-colors">{filter.name}</span>
              </button>
            );
          })}
        </div>

        {/* ─── BENTO GRID ESTANDARIZADO PANGEA ─── */}
        <div class="grid grid-cols-1 md:grid-cols-6 auto-rows-[410px] gap-8" id="tier-grid">
          {tierEntries.map((entry: any, i: number) => {
            const isBig = i === 0;
            return (
              <a 
                href={`/tier/${entry.slug}`} 
                data-game={(entry.gameName || 'UNKNOWN').toUpperCase()}
                
                class={`tier-card group relative bg-pangea-card/40 backdrop-blur-xl border border-white/5 rounded-[1.8rem] overflow-hidden transition-all duration-500 lg:hover:-translate-y-2 flex flex-col shadow-2xl ${isBig ? "md:col-span-4 md:row-span-2" : "md:col-span-2 md:row-span-1"}`}
                onmouseenter="this.style.borderColor='#00FF66'; this.style.boxShadow='0 0 25px rgba(0,255,102,0.6), inset 0 0 10px rgba(0,255,102,0.3)';"
                onmouseleave="this.style.borderColor='rgba(255,255,255,0.05)'; this.style.boxShadow='none';"
              >
                {/* Imagen Responsiva y Gradiente */}
                <div class="absolute inset-0 z-0 pointer-events-none">
                  {entry.heroImage && (
                    <img src={entry.heroImage} alt={entry.title} class="w-full h-full object-cover grayscale-0 opacity-80 lg:grayscale lg:opacity-40 lg:group-hover:grayscale-0 lg:group-hover:opacity-80 transition-all duration-700" />
                  )}
                  {/* bg-linear-to-t (Tailwind v4 ready) o bg-gradient-to-t */}
                  <div class="absolute h-[60%] bottom-0 inset-x-0 bg-gradient-to-t from-[#020202] via-[#020202]/95 to-transparent z-10 transition-all duration-500"></div>
                </div>

                {/* Contenido (Etiquetas Top) */}
                <div class="relative z-20 p-6 md:p-8 flex justify-between items-start w-full">
                  <div class="flex flex-col gap-1">
                    <span class="text-[#00FF66] font-mono text-[10px] font-bold tracking-widest uppercase">{entry.gameName}</span>
                    <span class="text-white/40 font-mono text-[8px] uppercase tracking-widest">Score // {entry.rankScore}%</span>
                  </div>
                  {/* Rango (S, A, B) */}
                  <div class="px-4 py-2 border-2 rounded-lg backdrop-blur-md shadow-lg transition-transform duration-500 group-hover:scale-105" style={{ borderColor: ACCENT_COLOR, backgroundColor: 'rgba(0,0,0,0.5)' }}>
                    <span class="font-headline text-2xl font-[950] italic tracking-tighter" style={{ color: ACCENT_COLOR }}>{entry.rank || 'S'}</span>
                  </div>
                </div>

                {/* Título y Descripción Inferior */}
                <div class="relative z-20 p-6 md:p-8 flex flex-col w-full mt-auto">
                  <h2 class={`font-headline font-[950] text-white uppercase italic tracking-tighter leading-[0.9] mb-2 break-words hyphens-auto transition-all duration-300 ${getFontSize(entry.title, isBig)}`} style={{ textShadow: `0 2px 10px rgba(0,0,0,0.5)` }}>
                    {entry.title}
                  </h2>
                  
                  <div class="grid transition-all duration-500 ease-in-out grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr] w-full">
                    <div class="overflow-hidden opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500">
                      <p class="text-white/70 text-[11px] md:text-sm italic leading-relaxed line-clamp-2 mt-2 break-words">
                        {entry.description}
                      </p>
                    </div>
                  </div>

                  {/* Footer del Bento */}
                  <div class="flex items-center justify-between border-t border-white/5 pt-4 mt-4">
                    <div class="flex items-center gap-2 text-white/40 font-mono text-[9px] font-black uppercase tracking-widest">
                      <Clock size={12} style={{ color: ACCENT_COLOR }} /> 
                      {entry.publishedAt ? new Date(entry.publishedAt).toLocaleDateString('es-MX', { month: 'short', day: '2-digit' }) : 'ARCHIVO_ACTIVO'}
                    </div>
                    <ArrowRight size={18} className="text-white/40 -translate-x-2 group-hover:text-white group-hover:translate-x-0 transition-all duration-500" style={{ color: ACCENT_COLOR }} />
                  </div>
                </div>

                {/* 🔥 FIX 4: BARRA INFERIOR NEÓN ESTANDARIZADA 🔥 */}
                <div 
                  class="absolute bottom-0 left-0 h-1.5 transition-all duration-1000 w-0 lg:group-hover:w-full z-30" 
                  style={{ backgroundColor: ACCENT_COLOR, boxShadow: `0 0 15px ${ACCENT_COLOR}` }}
                ></div>
                
                {/* Patrón Táctico de Fondo Opaco */}
                <div class="absolute inset-0 pointer-events-none opacity-[0.03] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(0,255,102,0.06),rgba(0,255,102,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%] z-20"></div>
              </a>
            );
          })}
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tier-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const cardGame = card.getAttribute('data-game');
          if (filterValue === 'ALL' || cardGame === filterValue) {
            (card as HTMLElement).style.display = 'flex'; 
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style is:global>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 35s linear infinite;
  }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>