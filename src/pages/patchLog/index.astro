---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import PatchLogGrid from '../../components/home/PatchLogGrid'; 
import { sanityClient } from "sanity:client";
import { ArrowLeft, Activity } from 'lucide-react';
// 🔥 Importamos el componente de anuncios


const rawPatches = await sanityClient.fetch(`*[_type == "patchNote"] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  "game": game->name,
  version,
  patchType,
  description,
  "image": mainImage.asset->url,
  publishedAt,
  lastUpdateAt,
  tickerHighlights
}`);

// --- ADN DE LA SECCIÓN: MORADO CYBERPUNK ---
const ACCENT_COLOR = "#b829ff"; 
---

<Layout title="PATCH LOGS | PANGGEA">
  <Header client:load />

  {/* 🔥 FIX 1: Estandarización del fondo. Usamos bg-pangea-neutral y centramos los contenedores */}
  <main class="bg-pangea-neutral min-h-screen pt-44 pb-20 relative overflow-hidden flex flex-col items-center w-full transition-colors duration-500 font-sans">
    
    {/* 🔥 FIX 2: GLOW SEMÁNTICO EN EL FONDO ABSOLUTO (Estilo Archivo) */}
    <div class="absolute inset-0 pointer-events-none" 
         style={`background: radial-gradient(circle at 50% 0%, ${ACCENT_COLOR}10 0%, transparent 70%)`}>
    </div>

    {/* 🔥 FIX 3: Estructura Estándar de Contenedores (1600px exterior, 1200px interior) */}
    <div class="flex w-full max-w-[1600px] justify-center items-start gap-12 px-4 md:px-6 relative z-10">
      
      <div class="max-w-[1200px] w-full">

        {/* ─── BOTÓN DE REGRESO ESTANDARIZADO ─── */}
        <button 
          type="button"
          onclick="window.history.back();" 
          class="group flex items-center gap-4 mb-10 text-white/30 hover:text-white transition-colors font-mono text-[10px] tracking-[0.3em] uppercase cursor-pointer w-max focus:outline-none"
        >
          <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-[#b829ff]/60 group-hover:shadow-[0_0_15px_rgba(184,41,255,0.3)]">
            <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
          </div>
          <span class="transition-colors duration-300 group-hover:text-[#b829ff]">Volver Atrás</span>
        </button>

        {/* ─── HEADER TERMINAL ESTANDARIZADO (Se alinea al comportamiento de "ARCHIVO PANGEA") ─── */}
        <header class="mb-14 border-b border-white/10 pb-10">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div>
              <div class="flex items-center gap-3 mb-6 bg-white/[0.02] border border-white/5 px-4 py-2 w-max">
                <div class="w-2 h-2 rounded-full animate-pulse" style={`background-color: ${ACCENT_COLOR}; box-shadow: 0 0 10px ${ACCENT_COLOR};`}></div>
                <span class="font-mono text-[9px] tracking-[0.4em] uppercase text-white/60">
                  STATUS: <span style={`color: ${ACCENT_COLOR}`}>MONITORING</span> // V.2.6
                </span>
              </div>
              
              {/* Título estandarizado con responsive y drop-shadow */}
              <h2 class="font-headline text-white text-5xl sm:text-7xl md:text-8xl lg:text-[105px] font-[950] tracking-tighter leading-[0.85] uppercase italic drop-shadow-2xl whitespace-nowrap overflow-hidden transition-all duration-500">
                SYSTEM <br/>
                <span class="text-transparent" style={{ WebkitTextStroke: `2px ${ACCENT_COLOR}` }}>UPDATE</span>
              </h2>
            </div>

            <div class="font-mono text-[10px] text-white/40 uppercase tracking-widest flex flex-col gap-3 text-left md:text-right border-l md:border-l-0 md:border-r border-white/10 pl-4 md:pl-0 md:pr-4 mt-8 md:mt-0">
              <div class="flex items-center md:justify-end gap-2">
                <Activity size={12} color={ACCENT_COLOR} />
                <span>Registro de Meta Activo</span>
              </div>
              <span>Entradas de Sistema: {rawPatches.length}</span>
              <span style={`color: ${ACCENT_COLOR}`}>SINC_TERMINAL_OK</span>
            </div>
          </div>
        </header>

        {/* ─── GRID DE PARCHES (REACT) ─── */}
        <PatchLogGrid client:load patches={rawPatches} accentColor={ACCENT_COLOR} />

      </div>

    </div>
  </main>
</Layout>