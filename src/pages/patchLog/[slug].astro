---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import PortableText from '../../components/PortableText.astro';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Terminal, Cpu, Zap, Activity, Clock, History, Gamepad2 } from 'lucide-react';
// 🔥 Importamos los componentes nuevos
import SharedButton from '../../components/layout/SharedButton';
import { AdSlot } from '../../components/layout/AdSlot';
import Community from '../../src/components/home/Community';

// ─── ADN MORADO NEÓN ───
const ACCENT_COLOR = "#b829ff";

export async function getStaticPaths() {
  const patches = await sanityClient.fetch<any[]>(`*[_type == "patchNote" && defined(slug.current)]{
    "slug": slug.current
  }`);
  return patches.map((p: any) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

const patch = await sanityClient.fetch(`*[_type == "patchNote" && slug.current == $slug][0]{
  title,
  "slug": slug.current,
  "gameName": game->name,
  version,
  patchType,
  description,
  "image": mainImage.asset->url,
  publishedAt,
  lastUpdateAt,
  tickerHighlights,
  body
}`, { slug });

if (!patch) {
  return Astro.redirect('/patch-log');
}

const formatDate = (date: string) => new Date(date).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
}).toUpperCase();

const highlights = Array.isArray(patch.tickerHighlights) ? patch.tickerHighlights : [];
const currentUrl = Astro.url.href;
---

<Layout title={`${patch.gameName || 'PATCH'} | ${patch.version} | PanGGea`} description={patch.description} image={patch.image}>
  <Header client:load />

  <main class="bg-[#020202] min-h-screen relative font-sans text-white overflow-hidden">
    
    <div class="absolute inset-0 pointer-events-none" 
         style={`background: radial-gradient(circle at 50% 0%, ${ACCENT_COLOR}15 0%, transparent 70%)`}>
    </div>

    {/* 📸 HERO SECTION */}
    <div class="relative w-full h-[60vh] min-h-[500px] flex items-end pb-16 border-b border-white/10">
      <div class="absolute inset-0 z-0 bg-[#050505]">
        {patch.image ? (
          <img src={patch.image} alt={patch.title} class="w-full h-full object-cover opacity-30 grayscale hover:grayscale-0 transition-all duration-1000" />
        ) : (
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(184,41,255,0.1)_0%,transparent_70%)]"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/60 to-transparent"></div>
      </div>

      <div class="max-w-[1200px] mx-auto px-6 w-full relative z-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 border border-white/10 bg-black/80 text-white">
            VERSION: <span style={`color: ${ACCENT_COLOR}`}>{patch.version}</span>
          </span>
          <span class="font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 border border-white/10 bg-white/5 text-white/70">
              SYSTEM // {patch.patchType || 'STABLE'}
          </span>
        </div>

        <h1 class="font-headline text-5xl md:text-7xl lg:text-[100px] font-black uppercase italic leading-[0.85] mb-8 tracking-tighter text-white drop-shadow-[0_0_30px_rgba(184,41,255,0.3)] break-words">
          {patch.gameName || patch.title}
        </h1>

        <div class="flex flex-wrap items-center gap-8 border-t border-white/10 pt-8">
          <div class="flex items-center gap-3">
            <Activity size={18} color={ACCENT_COLOR} />
            <div>
              <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Deployment</span>
              <span class="block font-bold text-sm text-white">{formatDate(patch.publishedAt)}</span>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <Gamepad2 size={18} color={ACCENT_COLOR} />
            <div>
              <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Base System</span>
              <span class="block font-bold text-sm text-white uppercase">{patch.gameName || 'PANGGEA_LABS'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* 📝 CONTENIDO CON ADS ESCOLTA */}
    <div class="max-w-[1750px] mx-auto px-4 md:px-6 py-16 lg:py-24 relative z-10 flex justify-center items-start gap-8 xl:gap-12">
      
      {/* 🔥 AD IZQUIERDA (Sticky junto al texto) */}
      <aside class="hidden 2xl:block w-[160px] sticky top-32 h-[600px] shrink-0 border border-purple-950/30 bg-[#050505]">
         <div class="w-full h-full relative group overflow-hidden">
            <span class="absolute top-2 left-2 font-mono text-[7px] text-white/20 uppercase tracking-[0.3em]">Protocol_Ad_L</span>
            <div class="flex items-center justify-center h-full pt-6">
               <AdSlot slot="1794581943" client:only="react" />
            </div>
            <div class="absolute bottom-0 left-0 h-[1px] w-0 group-hover:w-full bg-[#b829ff] transition-all duration-700 shadow-[0_0_15px_#b829ff]"></div>
         </div>
      </aside>

      {/* COLUMNA CENTRAL (Contenido Original) */}
      <div class="max-w-[1200px] w-full flex-grow">
        
        <div class="mb-16">
          <button onclick="window.history.back();" class="group flex items-center gap-4 text-white/30 transition-colors font-mono text-[10px] uppercase tracking-[0.3em] cursor-pointer w-max">
            <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-purple-500/50 group-hover:shadow-[0_0_15px_rgba(184,41,255,0.3)]">
              <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
            </div>
            <span class="group-hover:text-purple-400 transition-colors">SALIR_DEL_REGISTRO</span>
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
          
          {/* COLUMNA IZQUIERDA */}
          <div class="lg:col-span-8">
            {patch.description && (
              <div class="text-xl font-headline italic text-white/60 leading-relaxed mb-12 border-l-4 pl-6 break-words" style={`border-color: ${ACCENT_COLOR}`}>
                {patch.description}
              </div>
            )}

            <div class="prose prose-invert prose-p:text-white/60 max-w-none break-words prose-li:marker:text-purple-500 prose-a:text-purple-400 mb-20">
              {patch.body ? <PortableText value={patch.body} /> : <p class="font-mono text-xs opacity-40 italic">&gt;_ Cargando datos...</p>}
            </div>
          </div>

          {/* COLUMNA DERECHA: SIDEBAR TÁCTICO */}
          <div class="lg:col-span-4">
            <div class="bg-[#050505] border border-white/5 p-8 shadow-2xl relative lg:sticky lg:top-32 group overflow-hidden">
              
              <div class="flex items-center gap-3 mb-8">
                <Terminal size={16} color={ACCENT_COLOR} />
                <span class="font-mono text-[10px] text-white/60 font-bold uppercase tracking-widest">Resumen de Cambios</span>
              </div>

              {/* HIGHLIGHTS */}
              <div class="space-y-6 mb-10">
                {highlights.length > 0 ? highlights.map((text: string) => (
                  <div class="flex items-start gap-4 border-b border-white/5 pb-4 last:border-0">
                    <Zap size={14} className="mt-1 flex-shrink-0" color={ACCENT_COLOR} />
                    <span class="font-mono text-[11px] text-white/80 leading-snug uppercase tracking-wider break-words">{text}</span>
                  </div>
                )) : <p class="font-mono text-[9px] text-white/20 italic">No hay highlights.</p>}
              </div>

              {/* METADATOS TÉCNICOS */}
              <div class="pt-8 border-t border-white/10 space-y-4 mb-10">
                <div class="flex justify-between items-center">
                  <div class="flex items-center gap-2">
                     <Gamepad2 size={12} color={ACCENT_COLOR} className="opacity-50" />
                     <span class="font-mono text-[8px] text-white/30 uppercase">Game_ID</span>
                  </div>
                  <span class="font-mono text-[8px] text-white font-bold">{patch.gameName || 'N/A'}</span>
                </div>

                <div class="flex justify-between items-center">
                  <div class="flex items-center gap-2">
                     <Cpu size={12} color={ACCENT_COLOR} className="opacity-50" />
                     <span class="font-mono text-[8px] text-white/30 uppercase">Patch_Type</span>
                  </div>
                  <span class="font-mono text-[8px] text-white font-bold" style={`color: ${ACCENT_COLOR}`}>{patch.patchType || 'STABLE'}</span>
                </div>

                <div class="flex justify-between items-center border-t border-white/5 pt-4">
                  <div class="flex items-center gap-2">
                     <History size={12} color={ACCENT_COLOR} className="opacity-50" />
                     <span class="font-mono text-[8px] text-white/30 uppercase">Prev_Version</span>
                  </div>
                  <span class="font-mono text-[8px] text-white/50 italic">
                    {patch.lastUpdateAt ? formatDate(patch.lastUpdateAt) : 'INITIAL_BUILD'}
                  </span>
                </div>
              </div>

              {/* 🔥 SHARED BUTTON INTEGRADO EN EL SIDEBAR */}
              <div class="pt-8 border-t border-white/10">
                 <SharedButton 
                    client:load 
                    title={patch.title} 
                    text={patch.description} 
                    url={currentUrl} 
                 />
              </div>

            </div>

            {/* 🔥 AD DERECHA (Sticky debajo del SharedButton en pantallas gigantes) */}
            <div class="hidden 2xl:block w-[160px] h-[600px] shrink-0 sticky top-[600px] border border-purple-950/30 bg-[#050505] mt-10">
              <div class="w-full h-full relative group overflow-hidden">
                <span class="absolute top-2 left-2 font-mono text-[7px] text-white/20 uppercase tracking-[0.3em]">Protocol_Ad_R</span>
                <div class="flex items-center justify-center h-full pt-6">
                  <AdSlot slot="2057471674" client:only="react" />
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* 🔥 ADS HASTA ABAJO (Horizontal PC y Box Móvil) */}
        <div class="mt-20 flex flex-col gap-10">
           {/* Desktop */}
           <div class="hidden lg:flex w-full min-h-[150px] bg-[#050505] border border-white/5 relative group flex-col justify-center overflow-hidden transition-all duration-500 hover:border-[#b829ff]/50">
              <div class="absolute top-3 left-6 z-10">
                <span class="font-mono text-[8px] text-white/20 uppercase tracking-[0.2em]">Sponsored_Node</span>
              </div>
              <div class="relative z-20 w-full h-full flex items-center justify-center p-4 pt-10">
                 <AdSlot slot="4821639929" format="auto" client:only="react" />
              </div>
              <div class="absolute bottom-0 left-0 h-[2px] w-0 group-hover:w-full bg-[#b829ff] transition-all duration-700 shadow-[0_0_15px_#b829ff]" />
           </div>

           {/* Mobile */}
           <div class="flex lg:hidden w-full min-h-[250px] bg-[#050505] border border-white/5 relative group flex-col justify-center overflow-hidden">
              <div class="relative z-20 w-full h-full flex items-center justify-center p-4">
                 <AdSlot slot="4819366386" format="auto" client:only="react" />
              </div>
           </div>
        </div>

        <div class="mt-20">
           <Community client:load />
        </div>

      </div>

    </div>
  </main>
  <Footer />
</Layout>