---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import RadarCalendar from '../../components/radar/RadarCalendar';
import { sanityClient } from "sanity:client";
import { Activity, Archive, Crosshair, Zap } from 'lucide-react';

const radarEvents = await sanityClient.fetch(`*[_type == "radarEvent"] | order(eventDate asc) {
  title,
  "slug": slug.current,
  eventDate,
  description,
  "category": category->title,
  platform,
  hypeLevel,
  "heroImage": mainImage.asset->url
}`);

const today = new Date();
today.setHours(0,0,0,0); 

const upcoming = radarEvents.filter((e: any) => new Date(e.eventDate) >= today);
const past = radarEvents.filter((e: any) => new Date(e.eventDate) < today).reverse();

const mapEvent = (ev: any) => {
  const d = new Date(ev.eventDate);
  return {
    ...ev,
    day: d.getDate().toString().padStart(2, '0'),
    month: d.toLocaleString('es-MX', { month: 'short' }).toUpperCase().replace('.', ''),
  };
};

const upcomingMapped = upcoming.map(mapEvent);
const pastMapped = past.map(mapEvent);

const marqueeItems = [...upcomingMapped, ...upcomingMapped, ...upcomingMapped];

const upcomingCategories = Array.from(new Set(upcomingMapped.map((ev: any) => (ev.category || 'GENERAL').toUpperCase())));
const filters = ['TODOS', ...upcomingCategories];

const ACCENT_COLOR = "#00F0FF"; 

function getHypeColor(level: number) {
  if (level >= 90) return '#FF0055'; // Rojo
  if (level >= 75) return '#00FF66'; // Verde
  return '#00F0FF'; // Cyan
}

// 🧠 ALGORITMO LÍQUIDO: Calcula el tamaño de fuente exacto en px para encoger el texto sin truncarlo
const calculateFontSize = (text: string, isBigCard: boolean = false) => {
  const len = text?.length || 0;
  const baseSize = isBigCard ? 38 : 24; 
  
  if (len <= 14) return `${baseSize}px`;
  
  const reductionFactor = isBigCard ? 0.45 : 0.28;
  const scaledSize = baseSize - (len - 14) * reductionFactor;
  const minSize = isBigCard ? 18 : 13; 
  
  return `${Math.max(minSize, scaledSize)}px`;
};
---

<Layout title="RADAR GLOBAL | PanGGea">
  <Header client:load />

  <main class="bg-pangea-neutral min-h-screen pt-44 pb-32 relative overflow-hidden flex flex-col items-center w-full transition-colors duration-500">
    
    <div class="absolute inset-0 pointer-events-none">
       <div class="absolute top-[-20%] left-1/2 -translate-x-1/2 w-[1200px] h-[1200px] rounded-full border border-[#00F0FF]/5"></div>
       <div class="absolute top-[-20%] left-1/2 -translate-x-1/2 w-[1200px] h-[1200px] bg-[conic-gradient(from_0deg,transparent_0%,#00F0FF08_50%,transparent_100%)] animate-radar-spin"></div>
    </div>

    <div class="flex w-full max-w-[1600px] justify-center items-start px-4 md:px-6 relative z-10">
      <div class="max-w-[1200px] w-full">
        
        <header class="mb-24">
          <h1 class="font-headline text-white text-6xl md:text-8xl lg:text-[120px] font-[950] tracking-tighter leading-[0.8] uppercase italic">
            RADAR <span class="text-transparent" style={{ WebkitTextStroke: `2px ${ACCENT_COLOR}` }}> CENTRAL</span>
          </h1>
        </header>

        {/* ─── SECCIÓN 1: CARRUSEL INFINITO (TOP HYPE) ─── */}
        <section class="mb-44 w-full">
          <div class="flex items-center gap-4 mb-10 border-b border-white/10 pb-4">
             <Activity size={18} className="text-[#FF0055] animate-pulse" />
             <h2 class="font-mono text-[12px] text-white uppercase tracking-[0.4em] font-bold">Alerta Máxima // Top Hype</h2>
          </div>
          
          <div class="flex relative w-full overflow-hidden rounded-[1.8rem]">
            <div class="flex gap-8 animate-infinite-scroll hover:[animation-play-state:paused] py-4">
              {marqueeItems.map((ev, i) => {
                 const badgeColor = getHypeColor(ev.hypeLevel);
                 const monthColor = badgeColor === '#FF0055' ? '#ffffff' : badgeColor;

                 return (
                  <a 
                    href={`/radar/${ev.slug}`} 
                    class="radar-card group relative w-[350px] md:w-[420px] h-[410px] bg-pangea-card/40 backdrop-blur-xl border border-transparent rounded-[1.8rem] overflow-hidden flex flex-col shrink-0 transition-all duration-500 shadow-2xl lg:hover:-translate-y-2 z-30"
                    style={`--card-accent: ${badgeColor}; --card-accent-glow: ${badgeColor}60;`}
                  >
                    <div class="absolute inset-0 z-0 pointer-events-none">
                      <img src={ev.heroImage} alt={ev.title} class="absolute inset-0 w-full h-full object-cover grayscale-0 opacity-80 lg:grayscale lg:opacity-40 lg:group-hover:grayscale-0 lg:group-hover:opacity-80 transition-all duration-700" />
                      <div class="absolute h-[40%] bottom-0 inset-x-0 bg-gradient-to-t from-[#020202] via-[#020202]/95 to-transparent z-10 transition-all duration-500"></div>
                    </div>

                    {/* TOP BAR */}
                    <div class="relative z-20 p-6 md:p-8 flex justify-between items-start w-full">
                      <div>
                        <span class="font-headline text-5xl md:text-6xl text-white font-[950] italic leading-none block">{ev.day}</span>
                        <span class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.4em] font-black mt-1 block" style={{ color: monthColor }}>{ev.month}</span>
                      </div>
                      {/* Blindaje anti campos vacíos */}
                      {ev.category && (
                        <span class="font-mono text-[8px] font-black px-2.5 py-1.5 rounded-sm bg-black/50 uppercase tracking-widest backdrop-blur-md transition-colors border border-transparent text-white/80 lg:border-white/10 lg:group-hover:text-white lg:group-hover:border-[var(--card-accent)] group-hover:border-[var(--card-accent)]">
                          {ev.category}
                        </span>
                      )}
                    </div>

                    {/* BOTTOM BAR CON HOVER DINÁMICO */}
                    <div class="relative z-20 p-6 md:p-8 flex flex-col w-full mt-auto">
                      {/* 🔥 TÍTULO CORRECTAMENTE MAPEADO Y VISIBLE 🔥 */}
                      <h3 
                        class="neon-title font-headline font-black text-white uppercase italic tracking-tighter leading-[0.95] break-words hyphens-auto transition-all duration-300 mb-2"
                        style={`font-size: ${calculateFontSize(ev.title, true)};`}
                      >
                        {ev.title}
                      </h3>

                      <div class="grid transition-all duration-500 ease-in-out grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr]">
                        <div class="overflow-hidden opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-all duration-500">
                           <p class="text-white/70 text-[11px] italic leading-relaxed line-clamp-3 mb-4 break-words pt-4">
                             {ev.description || 'Analizando señal de lanzamiento...'}
                           </p>
                           <div class="pt-2 border-t border-white/5 flex flex-col mb-1">
                            <div class="flex flex-col gap-1.5">
                              <div class="flex justify-between items-center">
                                <span class="font-mono text-[8px] text-white/40 uppercase tracking-widest font-black">Hype Meter</span>
                                <span class="font-headline text-xs font-black italic" style={{ color: badgeColor }}>{ev.hypeLevel}%</span>
                              </div>
                              <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full transition-all duration-1000" style={{ width: `${ev.hypeLevel}%`, backgroundColor: badgeColor }} />
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="absolute bottom-0 left-0 h-1.5 transition-all duration-1000 w-full lg:w-0 lg:group-hover:w-full z-30" style={{ backgroundColor: badgeColor, boxShadow: `0 -5px 15px ${badgeColor}50` }} />
                  </a>
                 );
              })}
            </div>
          </div>
        </section>

        {/* CALENDARIO */}
        <section class="mb-44 w-full">
          <div class="flex items-center gap-4 mb-10 border-b border-white/10 pb-4">
             <Crosshair size={20} className="text-[#00F0FF]" />
             <h2 class="font-mono text-[12px] text-white uppercase tracking-[0.4em] font-bold">Radar de Despliegue // Calendario</h2>
          </div>
          <RadarCalendar client:load events={radarEvents} />
        </section>

        {/* ─── SECCIÓN 2: LO QUE VIENE (GRID + FILTROS) ─── */}
        <section class="mb-44 w-full">
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-10">
            <div class="flex items-center gap-4">
               <Zap size={20} className="text-[#00FF66]" />
               <h2 class="font-mono text-[12px] text-white uppercase tracking-[0.4em] font-bold">Lo Que Viene // Próximos Eventos</h2>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mb-12">
            {filters.map(cat => (
              <button 
                data-filter={cat}
                class={`radar-filter-btn px-5 py-2.5 border font-headline text-[10px] font-black italic tracking-[0.2em] uppercase transition-all duration-300 rounded-sm focus:outline-none
                ${cat === 'TODOS' ? 'border-white/40 bg-white/5 shadow-[0_0_15px_rgba(255,255,255,0.1)] text-[#00F0FF]' : 'bg-transparent border-white/5 text-white/30 hover:border-white/20'}`}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {upcomingMapped.length > 0 ? (
              upcomingMapped.map((ev: any) => {
                const badgeColor = getHypeColor(ev.hypeLevel);
                const monthColor = badgeColor === '#FF0055' ? '#ffffff' : badgeColor;

                return (
                  <a 
                    href={`/radar/${ev.slug}`} 
                    data-category={(ev.category || 'GENERAL').toUpperCase()}
                    class="upcoming-card radar-card group relative bg-pangea-card/40 backdrop-blur-xl border border-transparent rounded-[1.8rem] overflow-hidden transition-all duration-500 lg:hover:-translate-y-2 flex flex-col h-[410px] shadow-2xl z-30"
                    style={`--card-accent: ${badgeColor}; --card-accent-glow: ${badgeColor}60;`}
                  >
                    <div class="absolute inset-0 z-0 pointer-events-none">
                      <img src={ev.heroImage} alt={ev.title} class="absolute inset-0 w-full h-full object-cover grayscale-0 opacity-80 lg:grayscale lg:opacity-40 lg:group-hover:grayscale-0 lg:group-hover:opacity-80 transition-all duration-700" />
                      <div class="absolute h-[40%] bottom-0 inset-x-0 bg-gradient-to-t from-[#020202] via-[#020202]/95 to-transparent z-10 transition-all duration-500"></div>
                    </div>

                    {/* TOP BAR */}
                    <div class="relative z-20 p-6 md:p-8 flex justify-between items-start w-full">
                      <div>
                        <span class="font-headline text-5xl text-white font-[950] italic leading-none block">{ev.day}</span>
                        <span class="font-mono text-[10px] uppercase tracking-[0.4em] font-black mt-1 block" style={{ color: monthColor }}>{ev.month}</span>
                      </div>
                      {ev.category && (
                        <span class="font-mono text-[8px] font-black px-2 py-1 rounded-sm bg-black/50 uppercase tracking-widest backdrop-blur-md transition-all border border-transparent text-white/80 lg:border-white/10 lg:group-hover:text-white lg:group-hover:border-[var(--card-accent)] group-hover:border-[var(--card-accent)]">
                          {ev.category}
                        </span>
                      )}
                    </div>

                    {/* BOTTOM BAR (MÓVIL ACTIVO DEFAULT) */}
                    <div class="relative z-20 p-6 md:p-8 flex flex-col w-full mt-auto">
                      <h3 
                        class="neon-title font-headline font-black text-white uppercase italic tracking-tighter leading-[0.95] break-words hyphens-auto transition-all duration-300 mb-2"
                        style={`font-size: ${calculateFontSize(ev.title, false)};`}
                      >
                         {ev.title}
                      </h3>
                      
                      <div class="grid transition-all duration-500 ease-in-out grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr]">
                        <div class="overflow-hidden opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-all duration-500">
                           <p class="text-white/70 text-[11px] italic leading-relaxed line-clamp-3 mb-4 break-words pt-4">
                             {ev.description || 'Analizando señal de lanzamiento...'}
                           </p>
                           <div class="pt-2 border-t border-white/5 flex flex-col mb-1">
                            <div class="flex flex-col gap-1.5">
                              <div class="flex justify-between items-center">
                                <span class="font-mono text-[8px] text-white/40 uppercase tracking-widest font-black">Hype Meter</span>
                                <span class="font-headline text-xs font-black italic" style={{ color: badgeColor }}>{ev.hypeLevel}%</span>
                              </div>
                              <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full transition-all duration-1000" style={{ width: `${ev.hypeLevel}%`, backgroundColor: badgeColor }} />
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="absolute bottom-0 left-0 h-1.5 transition-all duration-1000 w-full lg:w-0 lg:group-hover:w-full z-30" style={{ backgroundColor: badgeColor, boxShadow: `0 -5px 15px ${badgeColor}50` }} />
                  </a>
                );
              })
            ) : (
              <div class="col-span-full w-full flex flex-col items-center justify-center border border-white/5 bg-pangea-card/20 rounded-[1.8rem] p-12 text-center">
                <span class="font-mono text-[10px] text-[#00F0FF] font-black tracking-[0.4em] uppercase mb-2">Signal_Lost // 404_Events</span>
                <p class="text-white/40 text-xs italic font-body max-w-xs">"No hay transmisiones entrantes registradas para el futuro."</p>
              </div>
            )}
          </div>
        </section>

        {/* ─── SECCIÓN 3: BENTO GRID (PASADOS - ESTANDARIZADA) ─── */}
        <section class="mb-32 w-full">
          <div class="flex items-center gap-4 mb-12 border-b border-white/10 pb-4">
             <Archive size={18} className="text-white/20" />
             <h2 class="font-mono text-[12px] text-white/40 uppercase tracking-[0.4em] font-bold">Registros del Sistema // Eventos Pasados</h2>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 auto-rows-[410px]">
            {pastMapped.slice(0, 3).map((ev: any, i: number) => {
              const badgeColor = getHypeColor(ev.hypeLevel);
              const monthColor = badgeColor === '#FF0055' ? '#ffffff' : badgeColor;
              const isFirstLarge = i === 0;

              return (
                <a 
                  href={`/radar/${ev.slug}`} 
                  class={`radar-card group relative bg-pangea-card/40 backdrop-blur-xl border border-transparent rounded-[1.8rem] overflow-hidden flex flex-col justify-between transition-all duration-500 shadow-2xl lg:hover:-translate-y-2 z-30
                    ${isFirstLarge ? "lg:col-span-2 lg:row-span-2 lg:h-full" : "lg:col-span-1 lg:row-span-1 h-[410px]"}`}
                  style={`--card-accent: ${badgeColor}; --card-accent-glow: ${badgeColor}60;`}
                >
                  <div class="absolute inset-0 z-0 pointer-events-none">
                    <img src={ev.heroImage} alt={ev.title} class="absolute inset-0 w-full h-full object-cover opacity-30 grayscale lg:opacity-30 lg:grayscale lg:group-hover:grayscale-0 lg:group-hover:opacity-80 transition-all duration-700" />
                    <div class="absolute h-[40%] bottom-0 inset-x-0 bg-gradient-to-t from-[#020202] via-[#020202]/95 to-transparent z-10" />
                  </div>

                  {/* TOP BAR */}
                  <div class="relative z-20 p-6 md:p-8 flex justify-between items-start w-full">
                    <div>
                      <span class="font-headline text-5xl text-white font-[950] italic leading-none block transition-colors">{ev.day}</span>
                      <span class="font-mono text-[10px] uppercase tracking-[0.4em] font-black mt-1 block transition-opacity" style={{ color: monthColor }}>{ev.month}</span>
                    </div>
                    {ev.category && (
                      <span class="font-mono text-[8px] font-black px-2 py-1 rounded-sm bg-black/50 uppercase tracking-widest backdrop-blur-md transition-colors border border-transparent text-white/60 lg:border-white/10 lg:group-hover:text-white/80 lg:group-hover:border-[var(--card-accent)] group-hover:border-[var(--card-accent)]">
                        {ev.category}
                      </span>
                    )}
                  </div>
                  
                  {/* BOTTOM BAR CON HOVER DINÁMICO */}
                  <div class="relative z-20 p-6 md:p-8 flex flex-col w-full mt-auto">
                    <h4 
                      class="neon-title font-headline font-black text-white uppercase italic tracking-tighter leading-[0.95] break-words hyphens-auto transition-colors mb-2"
                      style={`font-size: ${calculateFontSize(ev.title, isFirstLarge)};`}
                    >
                      {ev.title}
                    </h4>
                    
                    <div class="grid transition-all duration-500 ease-in-out grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr]">
                      <div class="overflow-hidden opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-all duration-500">
                         <p class="text-[11px] text-white/40 italic leading-relaxed line-clamp-3 mb-4 break-words pt-4">
                           {ev.description || 'Señal archivada de este lanzamiento...'}
                         </p>
                         <div class="pt-2 border-t border-white/5 flex flex-col mb-1 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                          <div class="flex flex-col gap-1.5">
                            <div class="flex justify-between items-center">
                              <span class="font-mono text-[8px] text-white/40 uppercase tracking-widest font-black">Hype Final</span>
                              <span class="font-headline text-xs font-black italic" style={{ color: badgeColor }}>{ev.hypeLevel}%</span>
                            </div>
                            <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full transition-all duration-1000" style={{ width: `${ev.hypeLevel}%`, backgroundColor: badgeColor }} />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="absolute bottom-0 left-0 h-1.5 transition-all duration-1000 w-full lg:w-0 lg:group-hover:w-full z-30" style={{ backgroundColor: badgeColor, boxShadow: `0 -5px 15px ${badgeColor}50` }} />
                </a>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.radar-filter-btn');
    const cards = document.querySelectorAll('.upcoming-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('border-white/40', 'bg-white/5', 'shadow-[0_0_15px_rgba(255,255,255,0.1)]', 'text-[#00F0FF]');
          b.classList.add('bg-transparent', 'border-white/5', 'text-white/30');
        });

        btn.classList.remove('bg-transparent', 'border-white/5', 'text-white/30');
        btn.classList.add('border-white/40', 'bg-white/5', 'shadow-[0_0_15px_rgba(255,255,255,0.1)]', 'text-[#00F0FF]');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const cardEl = card as HTMLElement;
          const cardCat = cardEl.getAttribute('data-category');
          if (filterValue === 'TODOS' || cardCat === filterValue) {
            cardEl.style.display = 'flex';
          } else {
            cardEl.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style is:global>
  @keyframes infinite-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.3333%); }
  }
  .animate-infinite-scroll {
    animation: infinite-scroll 45s linear infinite;
    width: max-content;
  }
  @keyframes radar-spin {
    from { transform: translate(-50%, 0) rotate(0deg); }
    to { transform: translate(-50%, 0) rotate(360deg); }
  }
  .animate-radar-spin { animation: radar-spin 15s linear infinite; }
  
  /* 🔥 NEÓN QUIRÚRGICO GLOBAL: Bordes y Títulos iluminados mediante variables CSS nativas 🔥 */
  @media (max-width: 1023px) {
    .radar-card {
      border-color: var(--card-accent) !important;
      box-shadow: 0 0 25px var(--card-accent-glow), inset 0 0 10px rgba(255,255,255,0.02) !important;
    }
    .radar-card .neon-title {
      text-shadow: 0 0 15px var(--card-accent), 0 0 30px var(--card-accent-glow), 0 2px 10px rgba(0,0,0,0.8) !important;
    }
  }
  @media (min-width: 1024px) {
    .group:hover {
      border-color: var(--card-accent) !important;
      box-shadow: 0 0 35px var(--card-accent-glow), inset 0 0 10px rgba(255,255,255,0.05) !important;
    }
    .group:hover .neon-title {
      text-shadow: 0 0 15px var(--card-accent), 0 0 30px var(--card-accent-glow), 0 2px 10px rgba(0,0,0,0.8) !important;
    }
  }
</style>