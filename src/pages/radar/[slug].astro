---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import PortableText from '../../components/PortableText.astro';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Radio, Calendar, Monitor, Activity, Info, Timer } from 'lucide-react';
// 🔥 Importamos componentes tácticos
import SharedButton from '../../components/layout/SharedButton';

const ACCENT_COLOR = "#00F0FF";
const HYPE_RED = "#FF0055"; 

export async function getStaticPaths() {
  const events = await sanityClient.fetch<any[]>(`*[_type == "radarEvent" && defined(slug.current)]{
    "slug": slug.current
  }`);
  return events.map((e: any) => ({
    params: { slug: e.slug },
  }));
}

const { slug } = Astro.params;

// 🚀 MAPEO ACTUALIZADO: CATEGORÍA Y JUEGO
const event = await sanityClient.fetch(`*[_type == "radarEvent" && slug.current == $slug][0]{
  title,
  "slug": slug.current,
  eventDate,
  "category": category->title,
  "gameName": relatedGame->name,
  platform,
  hypeLevel,
  "heroImage": mainImage.asset->url,
  description,
  content
}`, { slug });

if (!event) {
  return Astro.redirect('/radar');
}

const getHypeColor = (level: number) => {
  if (level >= 90) return '#FF0055'; 
  if (level >= 75) return '#00FF66'; 
  return '#00F0FF'; 
};

const hypeColor = getHypeColor(event.hypeLevel || 0);

const formatDate = (date: string) => new Date(date).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
}).toUpperCase();

const currentUrl = Astro.url.href;

// 🚀 LÓGICA DE REESCALADO DINÁMICO (TAMAÑOS OPTIMIZADOS)
const nameLength = event?.title?.length || 0;
let titleSizeClass = "text-5xl md:text-6xl lg:text-[80px]";

if (nameLength > 60) {
  titleSizeClass = "text-3xl md:text-4xl lg:text-[45px]";
} else if (nameLength > 35) {
  titleSizeClass = "text-4xl md:text-5xl lg:text-[60px]";
}
---

<Layout title={`${event.title} | RADAR PanGGea`} description={event.description}>
  <Header client:load />

  {/* 🔥 FIX STICKY DEFINITIVO: Quitamos el 'overflow-hidden' global que rompía el sticky 🔥 */}
  <main class="bg-[#020202] min-h-screen relative flex flex-col items-center font-sans text-white">
    
    {/* ANIMACIÓN DE RADAR FONDO (El overflow-hidden solo vive aquí para no romper el scroll) */}
    <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[1000px] h-[1000px] rounded-full border border-cyan-500/5"></div>
        <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[1000px] h-[1000px] bg-[conic-gradient(from_0deg,transparent_0%,#00F0FF05_50%,transparent_100%)] animate-radar-spin"></div>
    </div>

    {/* 📸 HERO SECTION CORREGIDO */}
    <section class="relative w-full h-[60vh] md:h-[75vh] flex items-end border-b border-white/5 overflow-hidden">
      <div class="absolute inset-0 z-0 bg-[#020202]">
        {event.heroImage ? (
          <img src={event.heroImage} alt={event.title} class="w-full h-full object-cover opacity-70" />
        ) : (
          <div class="absolute inset-0 bg-zinc-900/20"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/50 to-transparent"></div>
      </div>

      <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 pb-16">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="px-3 py-1 bg-[#00F0FF] text-black font-mono text-[10px] font-black uppercase tracking-widest rounded-sm shadow-[0_0_20px_rgba(0,240,255,0.4)]">
            {event.category || 'SIGNAL'}
          </span>
          {event.gameName && (
            <span class="px-3 py-1 bg-[#00F0FF]/10 border border-[#00F0FF]/30 text-[#00F0FF] font-mono text-[10px] font-black uppercase tracking-widest rounded-sm backdrop-blur-md">
              {event.gameName}
            </span>
          )}
          <span class="px-3 py-1 bg-white/5 border border-white/10 text-white/70 font-mono text-[10px] font-black uppercase tracking-widest rounded-sm backdrop-blur-md flex items-center gap-2">
            <Activity size={12} color={ACCENT_COLOR} />
            LIVE_TRACKING
          </span>
        </div>
        
        <h1 class={`font-headline ${titleSizeClass} font-black uppercase italic leading-[0.8] mb-8 text-white break-words drop-shadow-[0_0_30px_rgba(255,255,255,0.1)]`}>
          {event.title}
        </h1>

        <div class="flex flex-wrap items-center gap-8 md:gap-12 border-t border-white/10 pt-6">
          <div class="flex items-center gap-4">
            <Timer size={18} color={HYPE_RED} className="animate-pulse" />
            <div class="countdown-badge-detail flex flex-col" data-target-date={event.eventDate}>
              <span class="font-mono text-[7px] text-white/40 uppercase tracking-[0.3em] mb-0.5" style={{ color: HYPE_RED }}>HYPE TIMER</span>
              <span class="font-headline text-white font-bold tracking-widest uppercase italic text-sm text-[#00F0FF] cd-text-detail leading-none">SCANNING...</span>
            </div>
          </div>
          
          <div class="flex items-center gap-3 border-l border-white/10 pl-8">
            <Calendar size={18} className="text-white/20" />
            <div class="flex flex-col">
              <span class="font-mono text-[7px] text-white/40 uppercase tracking-[0.3em] mb-0.5">Estimated Drop</span>
              <span class="font-headline text-white font-bold tracking-widest uppercase italic text-sm">{formatDate(event.eventDate)}</span>
            </div>
          </div>
          
          <div class="flex items-center gap-3 border-l border-white/10 pl-8">
            <Monitor size={18} style={{ color: ACCENT_COLOR }} className="opacity-50" />
            <div class="flex flex-col">
              <span class="font-mono text-[7px] text-white/40 uppercase tracking-[0.3em] mb-0.5">Platform Target</span>
              <span class="font-headline text-white font-bold tracking-widest uppercase italic text-sm">{event.platform || 'GLOBAL'}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 🔥 CONTENEDOR PRINCIPAL: items-start permite que el sidebar baje 🔥 */}
    <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row justify-center items-start gap-12 px-6 py-20 relative z-10 w-full">
      
      <article class="flex-1 w-full max-w-[800px] break-words overflow-hidden">
        
        <button onclick="window.history.back()" class="group flex items-center gap-4 mb-12 text-white/30 hover:text-white transition-colors font-mono text-[10px] uppercase tracking-[0.3em] cursor-pointer w-max focus:outline-none">
          <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-[#00F0FF]/50 group-hover:shadow-[0_0_15px_rgba(0,240,255,0.3)]">
             <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
          </div>
          <span class="group-hover:text-[#00F0FF] transition-colors">Abortar_Consulta // Volver</span>
        </button>

        {event.description && (
          <div class="text-xl lg:text-2xl font-headline italic text-white/80 leading-relaxed mb-10 border-l-4 pl-6 break-words overflow-hidden" style={{ borderColor: ACCENT_COLOR }}>
            {event.description}
          </div>
        )}

        <div class="prose prose-invert prose-cyan max-w-none 
          prose-p:text-white/80 prose-p:leading-relaxed prose-p:text-lg prose-p:italic prose-p:mb-8
          prose-headings:font-headline prose-headings:uppercase prose-headings:italic prose-headings:tracking-tighter prose-headings:text-white
          prose-strong:text-[#00F0FF] prose-strong:font-[950]
          prose-a:text-[#00F0FF] hover:prose-a:text-white prose-img:rounded-xl
          break-words">
          {event.content ? (
             <PortableText value={event.content} />
          ) : (
             <p class="font-mono text-xs opacity-40 italic">&gt;_ Sincronizando datos...</p>
          )}
        </div>

      </article>

      {/* ─── COLUMNA DERECHA: SIDEBAR CON h-fit y self-start PARA STICKY ─── */}
      <aside class="w-full lg:w-[350px] shrink-0 relative lg:sticky lg:top-32 flex flex-col gap-8 h-fit self-start">
        <div class="bg-[#050505] border border-white/5 p-8 shadow-2xl overflow-hidden group hover:border-cyan-500/30 transition-colors rounded-2xl">
          <div class="flex items-center gap-3 mb-8">
            <Radio size={16} color={ACCENT_COLOR} className="animate-pulse" />
            <span class="font-mono text-[10px] text-white/60 font-bold uppercase tracking-widest">Signal_Strength</span>
          </div>

          <div class="mb-10">
              <div class="flex justify-between font-mono text-[9px] uppercase tracking-widest mb-3">
                  <span class="text-white/30">Hype_Capacity</span>
                  <span style={{ color: hypeColor }} class="font-bold">{event.hypeLevel}%</span>
              </div>
              <div class="h-2 bg-white/5 w-full overflow-hidden p-[1px] rounded-full">
                  <div class="h-full transition-all duration-1000 shadow-[0_0_15px_currentColor]" 
                       style={{ width: `${event.hypeLevel}%`, backgroundColor: hypeColor }}></div>
              </div>
          </div>

          <div class="space-y-6 pt-8 border-t border-white/10 mb-10">
            <div class="border-b border-white/5 pb-4">
              <span class="block text-white/30 font-mono text-[8px] uppercase tracking-widest mb-1">Source_Category</span>
              <span class="block text-white font-bold text-sm tracking-wide">{event.category}</span>
            </div>
            <div class="flex justify-between items-center opacity-40 hover:opacity-100 transition-opacity">
              <div class="flex items-center gap-2">
                 <Info size={14} color={ACCENT_COLOR} />
                 <span class="font-mono text-[9px] uppercase tracking-widest text-white">Status_Check</span>
              </div>
              <span class="font-mono text-[8px] text-green-400">EN_RADAR</span>
            </div>
          </div>

          {/* 🔥 FIX TS: Color forzado con CSS, sin error de tipeo en React 🔥 */}
          <div class="pt-8 border-t border-white/10 [&_svg]:!text-[#00F0FF] [&_svg]:!stroke-[#00F0FF] [&_*]:!text-[#00F0FF]">
             <SharedButton 
               client:load 
               title={event.title} 
               text={event.description} 
               url={currentUrl} 
             />
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script define:vars={{ eventDate: event.eventDate }}>
  function updateDetailCountdown() {
    const textSpan = document.querySelector('.cd-text-detail');
    const labelSpan = textSpan?.previousElementSibling;
    if (!textSpan) return;

    const now = new Date().getTime();
    const target = new Date(eventDate).getTime();
    const diff = target - now;

    if (diff <= 0) {
      textSpan.textContent = 'OBJECTIVE_LIVE';
      textSpan.style.color = '#FF0055';
      textSpan.style.textShadow = '0 0 15px #FF0055';
      if (labelSpan) labelSpan.textContent = 'SYSTEM ALERT';
    } else {
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      
      textSpan.textContent = `${d}D ${h}H ${m}M`;
      textSpan.style.color = '#00F0FF';
    }
  }
  updateDetailCountdown();
  setInterval(updateDetailCountdown, 60000); 
</script>

<style is:global>
  @keyframes radar-spin {
    from { transform: translate(-50%, 0) rotate(0deg); }
    to { transform: translate(-50%, 0) rotate(360deg); }
  }
  .animate-radar-spin {
    animation: radar-spin 12s linear infinite;
  }
</style>