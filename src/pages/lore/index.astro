---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import ArchiveGrid from '../../components/home/ArchiveGrid';
import { sanityClient } from "sanity:client";
import { ArrowLeft } from 'lucide-react';
// 🔥 Importamos el componente de anuncios


const rawPosts = await sanityClient.fetch(`*[_type == "post" && isDeepDive == true] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  "heroImage": mainImage.asset->url,
  description,
  readTime,
  isLegendary,
  publishedAt,
  "category": coalesce(categories[0]->title, "LORE"),
  platform
}`);

const categories = await sanityClient.fetch(`*[_type == "category"] | order(title asc) { title }`);
const categoryList = ['ALL', ...categories.map((c: { title: string }) => c.title)];

// --- ADN DE LA SECCIÓN: AMARILLO LEGENDARIO ---
const ACCENT_COLOR = "#FFD700"; 
---

<Layout title="DEEP DIVES | PANGGEA">
  <Header client:load />

  <main class="bg-[#020202] min-h-screen pt-44 pb-20 relative overflow-hidden font-sans">
    
    {/* Glow de fondo camaleón (Amarillo) */}
    <div class="absolute inset-0 pointer-events-none" 
         style={`background: radial-gradient(circle at 50% 0%, ${ACCENT_COLOR}10 0%, transparent 70%)`}>
    </div>

    <div class="max-w-[1750px] mx-auto px-6 flex justify-center items-start gap-10 relative z-10">
    

      <div class="flex-1 max-w-[1200px]">

        {/* ─── BOTÓN DE REGRESO ─── */}
        <button 
          type="button"
          onclick="window.history.back();" 
          class="group flex items-center gap-4 mb-12 text-white/30 transition-colors font-mono text-[10px] tracking-[0.3em] uppercase cursor-pointer w-max"
        >
          <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-[#FFD700]/60 group-hover:shadow-[0_0_15px_rgba(255,215,0,0.3)]">
            <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
          </div>
          <span class="group-hover:text-[#FFD700] transition-colors">Cerrar Archivo / Volver</span>
        </button>

        {/* ─── HEADER: GOLD STANDARD ─── */}
        <header class="mb-14">
          <h2 class="font-headline text-white text-4xl sm:text-6xl md:text-8xl lg:text-[105px] font-[950] tracking-tighter leading-none uppercase italic drop-shadow-2xl whitespace-nowrap overflow-hidden">
            DEEP 
            <span class="text-transparent" style={{ WebkitTextStroke: `2px ${ACCENT_COLOR}` }}> DIVES</span>
          </h2>
          <div class="flex items-center gap-4 mt-8 text-white/20 font-mono text-[10px] tracking-[0.4em] uppercase">
            <div class="w-12 h-[1px]" style={{ backgroundColor: ACCENT_COLOR, boxShadow: `0 0 10px ${ACCENT_COLOR}` }}></div>
            <span>Registros Legendarios: {rawPosts.length}</span>
          </div>
        </header>

        {/* ─── GRID DE ARCHIVOS (REACT) ─── */}
        <ArchiveGrid 
          client:load 
          posts={rawPosts} 
          categories={categoryList} 
          accentColor={ACCENT_COLOR} 
          basePath="/lore"
        />

      

      </div>

    

    </div>
  </main>

  
</Layout>