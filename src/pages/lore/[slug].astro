---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import PortableText from '../../components/PortableText.astro';
import { sanityClient } from "sanity:client";
import { ArrowLeft, Clock, PenTool, Monitor } from 'lucide-react';
import SidebarFicha from '../../components/ui/SidebarFicha';

const ACCENT_COLOR = "#FFD700";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && isDeepDive == true && defined(slug.current)]{
    "slug": slug.current
  }`);

  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(`*[_type == "post" && isDeepDive == true && slug.current == $slug][0]{
  title,
  "slug": slug.current,
  description,
  platform,
  readTime,
  isReview,
  reviewStats,
  "game": game->{
    name,
    "logo": logo.asset->url
  },
  "author": author->{
    name,
    "image": image.asset->url,
    bio,
    socials
  },
  "mainImage": mainImage.asset->url,
  "sectionBg": sectionBg.asset->url,
  "category": coalesce(categories[0]->title, "LORE"),
  publishedAt,
  body
}`, { slug });

if (!post) {
  return Astro.redirect('/lore'); 
}

// Formateamos la fecha para pasarla al Sidebar
const articleDate = new Date(post.publishedAt || Date.now()).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});

const nameLength = post?.title?.length || 0;
let titleSizeClass = "text-5xl md:text-6xl lg:text-[80px]";

if (nameLength > 60) {
  titleSizeClass = "text-3xl md:text-4xl lg:text-[45px]"; 
} else if (nameLength > 35) {
  titleSizeClass = "text-4xl md:text-5xl lg:text-[60px]"; 
}

const heroImage = post.sectionBg || post.mainImage;
const currentUrl = Astro.url.href;
---

<Layout title={`${post.title} | PanGGea`} description={post.description} image={post.sectionBg || post.mainImage}>
  <Header client:load />

  {/* 🔥 FIX STICKY: Le quitamos el overflow-hidden a main. Eso rompía el sticky en CSS 🔥 */}
  <main class="bg-[#020202] min-h-screen relative font-sans text-white">
    
    <div class="absolute inset-0 pointer-events-none" 
         style={`background: radial-gradient(circle at 50% 0%, ${ACCENT_COLOR}15 0%, transparent 70%)`}>
    </div>

    {/* 📸 HERO SECTION (Este sí puede llevar overflow-hidden localmente) */}
    <div class="relative w-full h-[70vh] min-h-[550px] flex items-end pb-16 border-b border-white/5 overflow-hidden">
      <div class="absolute inset-0 z-0 bg-[#050505] flex items-center justify-center">
        {heroImage ? (
          <img src={heroImage} alt={post.title} class="w-full h-full object-cover opacity-90" />
        ) : (
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,215,0,0.1)_0%,transparent_70%)]"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/80 to-transparent"></div>
      </div>

      <div class="max-w-[1200px] mx-auto px-6 w-full relative z-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 border backdrop-blur-md rounded-sm"
                style={`color: ${ACCENT_COLOR}; border-color: ${ACCENT_COLOR}40; background-color: rgba(0,0,0,0.5);`}>
            {post.category}
          </span>
          {post.platform && (
            <span class="border border-white/10 bg-black/50 backdrop-blur-sm text-white/70 font-mono text-[9px] font-black uppercase tracking-widest px-3 py-1.5 flex items-center gap-2 rounded-sm">
              <Monitor size={12} style={{ color: ACCENT_COLOR }} />
              {post.platform}
            </span>
          )}
        </div>

        <h1 class={`font-headline ${titleSizeClass} font-black uppercase italic leading-[0.8] mb-8 text-white break-words drop-shadow-2xl`}>
          {post.title}
        </h1>

        <div class="flex flex-wrap items-center gap-8 border-t border-white/10 pt-6">
          <div class="flex items-center gap-3">
             {post.author?.image ? (
                <img src={post.author.image} alt={post.author?.name} class="w-8 h-8 rounded-full object-cover border border-white/20" />
             ) : (
                <PenTool size={16} style={{ color: ACCENT_COLOR }} />
             )}
            <div>
              <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Autor</span>
              <span class="block font-bold text-sm text-white">{post.author?.name || 'PanGGea Team'}</span>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="w-1 h-6 bg-white/10 hidden md:block"></div>
            <div>
              <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Fecha de Ingreso</span>
              <span class="block font-bold text-sm text-white">{articleDate}</span>
            </div>
          </div>
          
          {post.readTime && (
            <div class="flex items-center gap-3">
              <div class="w-1 h-6 bg-white/10 hidden md:block"></div>
              <Clock size={16} style={{ color: ACCENT_COLOR }} />
              <div>
                <span class="block font-mono text-[8px] text-white/40 uppercase tracking-widest mb-0.5">Lectura</span>
                <span class="block font-bold text-sm text-white">{post.readTime}</span>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="max-w-[1750px] mx-auto px-4 md:px-6 py-16 lg:py-24 relative z-10 flex justify-center items-start gap-8 xl:gap-12 w-full">

      <div class="flex-1 max-w-[1200px] w-full">
        
        <div class="mb-12">
          <button onclick="window.history.back();" class="group flex items-center gap-4 text-white/30 transition-colors font-mono text-[10px] uppercase tracking-[0.3em] cursor-pointer w-max">
            <div class="p-2 border border-white/5 bg-white/[0.02] transition-all group-hover:border-[#FFD700]/50 group-hover:shadow-[0_0_15px_rgba(255,215,0,0.3)]">
              <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
            </div>
            <span class="group-hover:text-[#FFD700] transition-colors">Volver a los Archivos</span>
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 relative">
          
          <div class="lg:col-span-8">
            {post.description && (
              <div class="text-xl lg:text-2xl font-headline italic text-white/80 leading-relaxed mb-10 border-l-4 pl-6 break-words overflow-hidden" style={{ borderColor: ACCENT_COLOR }}>
                {post.description}
              </div>
            )}

            <div class="prose prose-invert prose-lg md:prose-xl prose-p:text-white/70 prose-headings:text-white prose-headings:font-headline prose-headings:uppercase prose-headings:italic prose-a:text-[#FFD700] hover:prose-a:text-white prose-img:rounded-xl max-w-none break-words mb-20">
              {post.body ? (
                <PortableText value={post.body} />
              ) : (
                <p class="font-mono text-xs opacity-40 italic">&gt;_ Procesando datos de inmersión...</p>
              )}
            </div>

            {/* TARJETA DEL AUTOR */}
            {post.author && (
              <div class="w-full border border-white/10 bg-[#050505] rounded-2xl p-8 md:p-12 mt-20 flex flex-col md:flex-row items-center md:items-start gap-8 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-2 h-full" style={`background-color: ${ACCENT_COLOR}`}></div>
                
                {post.author.image && (
                  <img src={post.author.image} alt={post.author.name} class="w-24 h-24 md:w-32 md:h-32 rounded-full object-cover border-4 border-white/5 shrink-0" />
                )}
                
                <div class="flex flex-col items-center md:items-start text-center md:text-left">
                  <span class="font-mono text-[9px] text-white/40 uppercase tracking-[0.4em] mb-2">Escrito Por</span>
                  <h4 class="font-headline text-3xl text-white uppercase italic font-black mb-4">{post.author.name}</h4>
                  
                  {post.author.bio && (
                    <div class="text-white/60 text-sm md:text-base leading-relaxed mb-6 max-w-2xl prose prose-invert">
                       <PortableText value={post.author.bio} />
                    </div>
                  )}

                  {post.author.socials && post.author.socials.length > 0 && (
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
                      {post.author.socials.map((social: any) => (
                        <a href={social.url} target="_blank" rel="noopener noreferrer" 
                           class="px-4 py-2 border border-white/10 bg-white/5 hover:bg-white/10 rounded-full font-mono text-[9px] uppercase tracking-widest text-white/70 hover:text-white transition-colors">
                          {social.platform}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}

          </div>

          {/* 🔥 SIDEBAR TÁCTICO STICKY (Ahora sí te sigue porque quitamos overflow-hidden) 🔥 */}
          <div class="lg:col-span-4 relative">
             <SidebarFicha 
                client:load 
                category={post.category} 
                platform={post.platform} 
                readTime={post.readTime}
                game={post.game}
                reviewStats={post.reviewStats}
                accentColor={ACCENT_COLOR}
                title={post.title}
                url={currentUrl}
                authorName={post.author?.name}
                publishDate={articleDate}
             />
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>