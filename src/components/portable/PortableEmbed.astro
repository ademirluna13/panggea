---
// src/components/portable/PortableEmbed.astro

// 1. Definimos qué rayos trae el "node"
interface Props {
  node: {
    url: string;
    layout?: 'left' | 'right' | 'center';
  }
}

const { node } = Astro.props as Props;
const { url, layout = 'center' } = node;

// --- LÓGICA DE YOUTUBE ---
function getYouTubeID(url: string) {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url?.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
}

// --- LÓGICA DE SPOTIFY ---
function getSpotifyEmbed(url: string) {
  if (!url) return null;
  return url.replace("open.spotify.com", "open.spotify.com/embed");
}

const youtubeId = getYouTubeID(url);
const spotifyUrl = !youtubeId ? getSpotifyEmbed(url) : null;
const isSpotify = !!spotifyUrl;

// --- DISEÑO Y FLOTACIÓN ---
const isCompact = layout === 'left' || layout === 'right';

const layoutClasses = {
  left: "float-left mr-6 mb-4 mt-2 w-full md:w-1/2",
  right: "float-right ml-6 mb-4 mt-2 w-full md:w-1/2",
  center: "block mx-auto mb-12 w-full"
};

// 2. Usamos un cast "as keyof typeof layoutClasses" para que TS no se queje
const currentLayout = layoutClasses[layout as keyof typeof layoutClasses] || layoutClasses.center;

const spotifyHeight = isCompact ? "152" : "352";
---

<div class={`${currentLayout} group`}>
  <div class="relative w-full rounded-sm border border-white/10 shadow-2xl overflow-hidden transition-all duration-700 group-hover:border-[#FF4500]/50 bg-black/40">
    
    {youtubeId && (
      <div class="aspect-video">
        <iframe
          class="absolute top-0 left-0 w-full h-full"
          src={`https://www.youtube.com/embed/${youtubeId}`}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {isSpotify && (
      <iframe
        style="border-radius:12px"
        src={`${spotifyUrl}?utm_source=generator&theme=0`}
        width="100%"
        height={spotifyHeight}
        frameborder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    )}

    {!youtubeId && !isSpotify && (
      <div class="p-4 text-center text-red-500 font-mono text-xs">
        ⚠️ URL Multimedia no válida
      </div>
    )}
  </div>
  
  <span class="block mt-2 font-mono text-[9px] text-white/20 uppercase tracking-widest text-center italic">
    {youtubeId ? 'Video Content' : 'Audio Stream'} PanGGea
  </span>
</div>