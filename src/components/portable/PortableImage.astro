---
// src/components/portable/PortableImage.astro
import { urlFor } from "../../utils/urlFor";

interface Props {
  node: {
image: any;
    asset: any;
    alt?: string;
    caption?: string;
    imageSize?: 'small' | 'medium' | 'large' | 'full'; // Nombre viejo del campo
    size?: 'small' | 'medium' | 'large' | 'full';      // Nombre nuevo si lo cambiaste en el esquema
    layout?: 'left' | 'right' | 'center'; // <--- LEEMOS LA NUEVA OPCIÓN
  }
}

const { node } = Astro.props as Props;

// Definimos los anchos de imagen igual que antes
const sizeClasses = {
  small: "md:w-1/4 w-full",
  medium: "md:w-1/2 w-full",
  large: "md:w-3/4 w-full",
  full: "w-full"
};

const currentSize = sizeClasses[node.size || node.imageSize || 'medium'] || sizeClasses.medium;

// 🚀 AQUÍ ESTÁ LA LÓGICA DE FLOTACIÓN (float) PARA QUE EL TEXTO ABRASE LA IMAGEN
// Le damos márgenes laterales y inferiores para que no se pegue al texto.
const layoutClasses = {
  left: "float-left mr-6 mb-4 mt-2", // Flota a la izquierda, margen derecho y abajo
  right: "float-right ml-6 mb-4 mt-2", // Flota a la derecha, margen izquierdo y abajo
  center: "block mx-auto mb-8" // Se queda centrado como un bloque separado
};

// Si por algo viene vacío, usamos 'center'
const currentLayout = layoutClasses[node.layout || 'center'];

// Usamos node directamente porque ya trae el asset dentro
const url = node.image ? urlFor(node.image).url() : urlFor(node).url();
---

{/* Quitamos mx-auto y flex del figure, y le aplicamos currentLayout */}
<figure class={`my-1 group w-full ${currentSize} ${currentLayout}`}>
  <img 
    src={url} 
    alt={node.alt || 'Media PanGGea'} 
    class="rounded-sm border border-white/10 shadow-2xl transition-all duration-700 group-hover:border-[#FF4500]/50 w-full h-auto"
    loading="lazy"
  />
  {node.caption && (
    <figcaption class="mt-4 font-mono text-[9px] text-white/20 uppercase tracking-widest italic text-center">
      {node.caption}
    </figcaption>
  )}
</figure>