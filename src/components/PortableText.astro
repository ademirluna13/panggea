---
import { PortableText as AstroPortableText } from "astro-portabletext";
import PortableImage from "./portable/PortableImage.astro";
import PortableLink from "./portable/PortableLink.astro";
import PortableMediaBlock from "./portable/PortableMediaBlock.astro";

// 🚀 IMPORTAMOS LOS COMPONENTES DE TEXTO, ANUNCIOS Y EMBEDS
import ColorMark from "./portable/ColorMark.astro";
import AlignMark from "./portable/AlignMark.astro";
import PortableAd from "./portable/PortableAd.astro";
import PortableEmbed from "./portable/PortableEmbed.astro"; // <--- El maestro de multimedia

const { value } = Astro.props;

const components = {
  type: {
    image: PortableImage,
    mediaBlock: PortableMediaBlock,
    adBlock: PortableAd,
    // 📺 🎵 Ambos usan el mismo componente inteligente
    youtube: PortableEmbed,
    spotify: PortableEmbed,
  },
  mark: {
    link: PortableLink,
    
    // Asignamos el componente del color
    textColor: ColorMark,
    
    // Asignamos el componente de alineación a los 3 botones
    center: AlignMark,
    justify: AlignMark,
    right: AlignMark,
  }
};
---

<div class="prose-bitxolo">
  <AstroPortableText value={value} components={components} />
</div>

<style is:global>
  .prose-bitxolo p {
    margin-bottom: 1.8rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.7);
  }
  .prose-bitxolo strong {
    color: white;
    font-weight: 900;
    border-bottom: 1px solid rgba(255, 69, 0, 0.2);
  }
  .prose-bitxolo h2 {
    font-family: 'Headline', sans-serif; 
    font-size: 2rem;
    color: white;
    text-transform: uppercase;
    font-style: italic;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
</style>