---
import { PortableText as AstroPortableText } from "astro-portabletext";
import PortableImage from "./portable/PortableImage.astro";
import PortableLink from "./portable/PortableLink.astro";

const { value } = Astro.props;

const components = {
  type: {
    image: PortableImage,
  },
  mark: {
    link: PortableLink,
    // La negrita la manejamos por CSS para evitar más líos
  }
};
---

<div class="prose-bitxolo">
  <AstroPortableText value={value} components={components} />
</div>

<style is:global>
  .prose-bitxolo p {
    margin-bottom: 1.8rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.7);
  }
  /* Esto arregla las negritas automáticamente */
  .prose-bitxolo strong {
    color: white;
    font-weight: 900;
    border-bottom: 1px solid rgba(255, 69, 0, 0.2);
  }
  .prose-bitxolo h2 {
    font-family: 'Headline', sans-serif; /* Ajusta a tu fuente */
    font-size: 2rem;
    color: white;
    text-transform: uppercase;
    font-style: italic;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
</style>